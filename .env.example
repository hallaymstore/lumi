PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/lumigirls
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars
SITE_URL=http://localhost:3000
VIEW_HASH_SALT=replace-with-another-random-secret

# Cloudflare R2 (S3 compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://cdn.example.com

# Safe admin bootstrap. Admin is NOT granted by public registration.
# In production set a unique 12+ character password, run npm run admin:bootstrap once,
# then you may remove ADMIN_PASSWORD from the runtime environment.
ADMIN_PHONE=+998901234567
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_12_PLUS_PASSWORD
ADMIN_USERNAME=lumiadmin
ADMIN_NAME=Lumi Admin

# Phone verification / password recovery
# development: OTP_REQUIRED=false works without an SMS provider.
# production: set true and configure provider.
OTP_REQUIRED=false
OTP_PROVIDER=console
OTP_SECRET=replace-with-otp-secret
OTP_TTL_MINUTES=5
# Eskiz option: OTP_PROVIDER=eskiz
ESKIZ_TOKEN=
ESKIZ_FROM=4546

# Optional Redis. Strongly recommended when deploying more than one Node instance.
REDIS_URL=

# Web Push (PWA notifications). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Media lifecycle cleanup interval (minutes)
MEDIA_CLEANUP_MINUTES=30

# Existing Adsterra banner-zone overrides. The app contains the current public
# placement IDs from hallaymstore/adsterra; set these only when zones change.
AD_NETWORK_320X50=
AD_NETWORK_300X250=
AD_NETWORK_468X60=
AD_NETWORK_728X90=

# R2 orphan scan (objects not referenced in DB and older than 24h)
R2_ORPHAN_SCAN=true
