<%- include('partials/head') %><%- include('partials/topbar') %>
<main class="content trending-page"><div class="explore-heading"><div><span class="settings-kicker">TRENDING</span><h1><%=activeTag?'#'+activeTag:'Trendlar'%></h1><p class="muted"><%=activeTag?'Shu hashtag bo‘yicha eng kuchli postlar.':'Oxirgi 30 kun ichidagi hashtaglar, creatorlar va engagement kuchli postlar.'%></p></div><a class="btn ghost" href="/explore"><i data-lucide="search"></i> Qidiruv</a></div>
<%if(tags&&tags.length){%><section class="trend-tag-card card"><h2 class="section-title">Trend hashtaglar</h2><div class="trend-tags"><%tags.forEach(t=>{%><a href="/tags/<%=encodeURIComponent(t._id)%>"><strong>#<%=t._id%></strong><small><%=t.posts||0%> post</small></a><%})%></div></section><%}%>
<%if(creators&&creators.length){%><h2 class="section-title">Creatorlar</h2><div class="creator-row"><%creators.forEach(u=>{%><a class="creator-pill" href="/u/<%=u.username%>"><span><img src="<%=u.avatarUrl||'/icons/icon-192.png'%>" class="<%=u.avatarUrl?'':'avatar-fallback'%>" alt=""></span><strong><%=u.name%></strong><small>@<%=u.username%> · <%=u.creatorCategory||'creator'%></small></a><%})%></div><%}%>
<h2 class="section-title">Trend postlar</h2><div class="explore-grid explore-grid-v15"><%posts.forEach(p=>{const m=(p.media&&p.media[0])||{url:p.imageUrl,type:'image'};%><a href="/p/<%=p._id%>" data-view-track data-post-id="<%=p._id%>"><%if(m.type==='video'){%><video src="<%=m.url%>" muted preload="metadata"></video><span class="tile-video"><i data-lucide="play"></i></span><%}else{%><img src="<%=m.thumbUrl||m.url%>" loading="lazy" alt="<%=(p.caption||'Lumi post').slice(0,80)%>"><%}%><span><i data-lucide="heart"></i> <%=p.likeCount||0%> · <i data-lucide="eye"></i> <b data-view-count><%=p.viewCount||0%></b></span></a><%})%></div><%if(!posts.length){%><section class="card empty-state"><i data-lucide="sparkles"></i><h2>Hozircha post yo‘q</h2><p>Bu trend uchun birinchi postni siz joylashingiz mumkin.</p></section><%}%></main><%- include('partials/footer') %>
