<%- include('../partials/head') %><%- include('../partials/topbar') %>
<main class="content settings-page"><div class="settings-head"><div><span class="settings-kicker">LUMI CONTROL</span><h1>Sozlamalar</h1><p class="muted">Profil, maxfiylik, safety, bildirishnoma va qurilmalarni boshqaring.</p></div><a class="btn ghost" href="/u/<%=currentUser.username%>"><i data-lucide="arrow-left"></i> Profil</a></div>
<%if(error){%><div class="alert"><%=error%></div><%}%><%if(saved){%><div class="success-alert"><i data-lucide="check-circle-2"></i> Saqlandi.</div><%}%>
<form class="settings-grid" method="post" action="/settings" enctype="multipart/form-data">
<section class="card settings-card"><div class="settings-card-title"><span><i data-lucide="user-round"></i></span><div><h2>Profil</h2><p>Public ko‘rinadigan ma’lumotlar</p></div></div><label>Avatar<input type="file" name="avatar" accept="image/jpeg,image/png,image/webp,image/avif"></label><label>Ism<input name="name" value="<%=currentUser.name%>" maxlength="60" required></label><label>Username<input value="@<%=currentUser.username%>" disabled></label><label>Telefon<input value="<%=currentUser.phone||'—'%>" disabled></label><label>Bio<textarea name="bio" maxlength="220" rows="4"><%=currentUser.bio||''%></textarea></label></section>
<section class="card settings-card"><div class="settings-card-title"><span><i data-lucide="shield-check"></i></span><div><h2>Maxfiylik</h2><p>Kim sizni ko‘radi va bog‘lana oladi</p></div></div><label class="setting-switch"><span><b>Yopiq profil</b><small>Yangi followerlar so‘rov yuboradi</small></span><input type="checkbox" name="isPrivate" <%=currentUser.isPrivate?'checked':''%>><i></i></label><label>Xabar yozishi<select name="allowMessages"><option value="everyone" <%=currentUser.allowMessages==='everyone'?'selected':''%>>Hamma</option><option value="following" <%=currentUser.allowMessages==='following'?'selected':''%>>Obuna aloqalari</option><option value="nobody" <%=currentUser.allowMessages==='nobody'?'selected':''%>>Hech kim</option></select></label><label>Mention qilishi<select name="allowMentions"><option value="everyone" <%=currentUser.allowMentions==='everyone'?'selected':''%>>Hamma</option><option value="following" <%=currentUser.allowMentions==='following'?'selected':''%>>Following</option><option value="nobody" <%=currentUser.allowMentions==='nobody'?'selected':''%>>Hech kim</option></select></label><label class="setting-switch"><span><b>Story reply</b><small>Storyga chat orqali javob</small></span><input type="checkbox" name="allowStoryReplies" <%=currentUser.allowStoryReplies!==false?'checked':''%>><i></i></label><label class="setting-switch"><span><b>Online holat</b><small>Chatda online holat ko‘rinsin</small></span><input type="checkbox" name="showActivityStatus" <%=currentUser.showActivityStatus!==false?'checked':''%>><i></i></label><label class="setting-switch"><span><b>Telefon orqali topish</b><small>Kontakt qidiruvida ko‘rining</small></span><input type="checkbox" name="discoverableByPhone" <%=currentUser.discoverableByPhone!==false?'checked':''%>><i></i></label><label>Yashirilgan so‘zlar<textarea name="hiddenWords" rows="3" placeholder="spam, yomon so‘z, ..."><%=(currentUser.hiddenWords||[]).join(', ')%></textarea></label></section>
<section class="card settings-card"><div class="settings-card-title"><span><i data-lucide="bell-ring"></i></span><div><h2>Bildirishnomalar</h2><p>In-app va Push</p></div></div><%[['notifyLikes','Like'],['notifyComments','Comment va reply'],['notifyFollows','Follower'],['notifyMessages','Chat xabarlar'],['notifyPush','Telefon push']].forEach(x=>{%><label class="setting-switch"><span><b><%=x[1]%></b></span><input type="checkbox" name="<%=x[0]%>" <%=currentUser[x[0]]!==false?'checked':''%>><i></i></label><%})%><button type="button" class="btn ghost full" data-push-enable><i data-lucide="bell-plus"></i> Push notificationni yoqish</button></section>
<section class="card settings-card"><div class="settings-card-title"><span><i data-lucide="smartphone"></i></span><div><h2>Ilova</h2><p>PWA va data</p></div></div><label class="setting-switch"><span><b>Data Saver</b><small>Rasm/video yuklashni yengillashtiradi</small></span><input type="checkbox" name="dataSaver" <%=currentUser.dataSaver?'checked':''%>><i></i></label><button type="button" class="btn ghost full" data-pwa-install hidden><i data-lucide="download"></i> Lumi ilovasini o‘rnatish</button><a class="btn ghost full" href="/saved"><i data-lucide="bookmark"></i> Saqlangan postlar</a><a class="btn ghost full" href="/creator/analytics"><i data-lucide="chart-no-axes-combined"></i> Creator Analytics</a></section>
<div class="settings-save"><button class="btn primary" type="submit"><i data-lucide="save"></i> Saqlash</button></div></form>
<div class="settings-grid lower-settings"><section class="card settings-card" id="close-friends"><div class="settings-card-title"><span><i data-lucide="star"></i></span><div><h2>Close Friends</h2><p>Story audience uchun</p></div></div><div class="settings-people"><%followers.slice(0,40).forEach(f=>{const u=f.follower;const active=(currentUser.closeFriends||[]).some(x=>String(x)===String(u._id));%><form method="post" action="/settings/close-friends/<%=u._id%>"><span class="avatar"><%if(u.avatarUrl){%><img src="<%=u.avatarUrl%>"><%}else{%><b><%=u.name[0]%></b><%}%></span><span><b><%=u.name%></b><small>@<%=u.username%></small></span><button class="btn <%=active?'primary':'ghost'%>"><%=active?'Yaqin do‘st':'Qo‘shish'%></button></form><%})%></div></section>
<section class="card settings-card"><div class="settings-card-title"><span><i data-lucide="ban"></i></span><div><h2>Safety listlari</h2><p>Block, Mute va Restrict</p></div></div><%[['Blocked','block',blocked],['Muted','mute',muted],['Restricted','restrict',restricted]].forEach(group=>{%><h3 class="settings-subtitle"><%=group[0]%></h3><div class="settings-people compact"><%if(!group[2].length){%><p class="muted tiny">Bo‘sh</p><%}%><%group[2].forEach(r=>{const u=r.target;if(!u)return;%><div class="settings-person-row"><span class="avatar"><%if(u.avatarUrl){%><img src="<%=u.avatarUrl%>"><%}else{%><b><%=u.name[0]%></b><%}%></span><span><b><%=u.name%></b><small>@<%=u.username%></small></span><button class="btn ghost compact" type="button" data-user-relation="<%=group[1]%>" data-username="<%=u.username%>">Olib tashlash</button></div><%})%></div><%})%></section>
<section class="card settings-card"><div class="settings-card-title"><span><i data-lucide="monitor-smartphone"></i></span><div><h2>Faol sessiyalar</h2><p>Qurilma va login tarixingiz</p></div></div><div class="session-list"><%sessions.forEach(s=>{%><div><i data-lucide="monitor"></i><span><b><%=(s.userAgent||'Qurilma').slice(0,80)%></b><small><%=new Date(s.lastSeenAt).toLocaleString('uz-UZ')%></small></span></div><%})%></div><form method="post" action="/settings/sessions/revoke-all"><button class="btn danger full">Barcha sessiyalarni bekor qilish</button></form></section>
<section class="card settings-card password-card"><div class="settings-card-title"><span><i data-lucide="key-round"></i></span><div><h2>Parol</h2><p>Yangilang</p></div></div><form method="post" action="/settings/password" class="password-form"><label>Hozirgi parol<input type="password" name="currentPassword" required></label><label>Yangi parol<input type="password" name="newPassword" minlength="8" required></label><button class="btn ghost">Yangilash</button></form></section></div>
<form method="post" action="/logout" class="settings-logout"><button class="btn danger"><i data-lucide="log-out"></i> Akkauntdan chiqish</button></form></main><%- include('../partials/footer') %>
