<%- include('../partials/head') %><%- include('../partials/topbar') %>
<main class="content profile-page"><section class="card"><div class="collection-head"><div><h1><%=heading%></h1><p class="muted tiny">Faqat siz ko‘ra oladigan boshqaruv bo‘limi</p></div><a class="btn ghost" href="/u/<%=currentUser.username%>">Profilga qaytish</a></div>
<%if(!posts.length){%><div class="collection-empty"><i data-lucide="folder-open"></i><h2><%=empty%></h2><%if(mode==='draft'){%><a class="btn primary" href="/posts/create">Yangi post</a><%}%></div><%}else{%><div class="manage-grid"><%posts.forEach(p=>{const m=(p.media&&p.media[0])||(p.imageUrl?{url:p.imageUrl,type:'image'}:null);%><article class="manage-card"><%if(m){%><%if(m.type==='video'){%><video src="<%=m.url%>" muted preload="metadata"></video><%}else{%><img src="<%=m.thumbUrl||m.url%>" alt=""><%}%><%}else{%><div class="collection-empty"><i data-lucide="file-text"></i></div><%}%><div class="manage-overlay"><a href="/posts/<%=p._id%>/edit">Tahrirlash</a><%if(mode==='draft'){%><form method="post" action="/posts/<%=p._id%>/publish"><button>Joylash</button></form><%}else{%><form method="post" action="/posts/<%=p._id%>/unarchive"><button>Qaytarish</button></form><%}%><form method="post" action="/posts/<%=p._id%>/delete"><button>O‘chirish</button></form></div></article><%})%></div><%}%></section></main><%- include('../partials/footer') %>
