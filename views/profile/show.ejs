<%- include('../partials/head') %><%- include('../partials/topbar') %>
<main class="content profile-page"><section class="profile-hero">
  <% const own=currentUser&&String(currentUser._id)===String(profile._id); %>
  <a class="profile-avatar <%=storyCount?'profile-has-story':''%>" href="<%=storyCount?(currentUser?'/stories/'+profile.username:'/login?next='+encodeURIComponent('/stories/'+profile.username)):'#'%>" <%=(!currentUser&&storyCount)?'data-auth-required':''%>><%if(profile.avatarUrl){%><img src="<%=profile.avatarUrl%>"><%}else{%><b><%=profile.name[0]%></b><%}%></a>
  <div class="profile-main"><h1><%=profile.name%> <%if(profile.isVerified){%><i class="verified" data-lucide="badge-check"></i><%}%> <%if(profile.isPrivate){%><i class="profile-lock" data-lucide="lock-keyhole"></i><%}%></h1><p class="handle">@<%=profile.username%></p><p><%=profile.bio%></p><div class="profile-stats"><span><b><%=profile.postCount||posts.length%></b> post</span><span><b><%=profile.followers||profile.followerCount||0%></b> follower</span><span><b><%=profile.following||profile.followingCount||0%></b> following</span></div>
  <div class="profile-buttons"><%if(own){%><a class="btn ghost" href="/settings"><i data-lucide="settings-2"></i> Sozlamalar</a><a class="btn primary" href="/stories/create"><i data-lucide="circle-plus"></i> Story</a><a class="btn ghost" href="/creator/analytics"><i data-lucide="chart-no-axes-combined"></i> Analytics</a><a class="btn ghost" href="/stories/archive/me"><i data-lucide="archive"></i> Story arxiv</a><%}else if(currentUser){%><form method="post" action="/u/<%=profile.username%>/follow"><button class="btn <%=isFollowing||followPending?'ghost':'primary'%>"><%=isFollowing?'Obunani bekor qilish':followPending?'So‘rov yuborildi':'Obuna bo‘lish'%></button></form><%if(isFollowing&&profile.allowMessages!=='nobody'){%><a class="btn primary" href="/chats/with/<%=profile.username%>"><i data-lucide="message-circle"></i> Xabar yozish</a><%}%><details class="profile-more"><summary class="btn ghost compact"><i data-lucide="ellipsis"></i></summary><div><button type="button" data-user-relation="mute" data-username="<%=profile.username%>">Mute</button><button type="button" data-user-relation="restrict" data-username="<%=profile.username%>">Restrict</button><button type="button" class="danger-text" data-user-relation="block" data-username="<%=profile.username%>">Block</button><button type="button" class="danger-text" data-user-report="<%=profile.username%>">Report</button></div></details><%}else{%><button class="btn primary" type="button" data-auth-required><i data-lucide="user-plus"></i> Obuna bo‘lish</button><button class="btn ghost" type="button" data-auth-required><i data-lucide="message-circle"></i> Xabar yozish</button><%}%><button class="btn ghost compact" type="button" data-share-profile data-profile-url="/u/<%=profile.username%>" data-profile-title="<%=profile.name%> (@<%=profile.username%>)"><i data-lucide="share-2"></i> Ulashish</button></div></div>
</section>
<%if(adConfig?.enabled&&adConfig.profileEnabled&&profileAds?.length){const ad=profileAds[0];%><section class="profile-ad-slot"><%- include('../partials/adcard',{ad,placement:'profile',variant:'banner',adConfig}) %></section><%}%>
<%if(highlights&&highlights.length){%><section class="highlight-rail"><%highlights.forEach(h=>{%><a href="/stories/<%=profile.username%>" class="highlight-bubble"><span><img src="<%=h.thumbUrl||h.mediaUrl%>"></span><small><%=h.highlightTitle||'Highlight'%></small></a><%})%></section><%}%>
<%if(!canSee){%><section class="private-profile card"><i data-lucide="lock"></i><h2>Bu profil yopiq</h2><p>Post va Storylarni ko‘rish uchun obuna so‘rovini yuboring.</p></section><%}else{%><div class="profile-grid"><%posts.forEach(p=>{const m=(p.media&&p.media[0])||{url:p.imageUrl,type:'image'};%><a class="profile-tile" href="/p/<%=p._id%>" data-view-track data-post-id="<%=p._id%>"><%if(m.type==='video'){%><video src="<%=m.url%>" muted preload="metadata"></video><span class="tile-video"><i data-lucide="play"></i></span><%}else{%><img src="<%=m.thumbUrl||m.url%>" loading="lazy"><%}%><span><i data-lucide="heart"></i> <%=p.likeCount||0%> · <i data-lucide="eye"></i> <b data-view-count><%=p.viewCount||0%></b></span><%if(p.isPinned){%><b class="tile-pin"><i data-lucide="pin"></i></b><%}%></a><%})%></div><%}%></main><%- include('../partials/footer') %>
