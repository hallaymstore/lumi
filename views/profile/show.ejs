<%- include('../partials/head') %><%- include('../partials/topbar') %>
<main class="content profile-page <%=profile.proExpiresAt&&new Date(profile.proExpiresAt)>new Date()?'pro-profile-'+(profile.proTheme||'default'):''%>"><section class="profile-hero">
  <% const own=currentUser&&String(currentUser._id)===String(profile._id); %>
  <a class="profile-avatar <%=storyCount?'profile-has-story':''%>" href="<%=storyCount?(currentUser?'/stories/'+profile.username:'/login?next='+encodeURIComponent('/stories/'+profile.username)):'#'%>" <%=(!currentUser&&storyCount)?'data-auth-required':''%>><img src="<%=profile.avatarUrl||'/icons/icon-192.png'%>" class="<%=profile.avatarUrl?'':'avatar-fallback'%>" alt="<%=profile.name%>"></a>
  <div class="profile-main"><h1><%=profile.name%> <%if(profile.isVerified){%><i class="verified" data-lucide="badge-check"></i><%}%> <%if(profile.proExpiresAt&&new Date(profile.proExpiresAt)>new Date()&&profile.accountOrigin!=='synthetic'){%><span class="lumi-pro-badge">✦ Pro</span><%}%> <%if(profile.isPrivate){%><i class="profile-lock" data-lucide="lock-keyhole"></i><%}%></h1><p class="handle">@<%=profile.username%> <%if(profile.accountOrigin==='synthetic'){%><span class="creator-mode-badge"><i data-lucide="bot"></i> Virtual profile</span><%}%> <%if(profile.creatorMode||profile.role==='creator'){%><span class="creator-mode-badge"><i data-lucide="sparkles"></i> Creator<%=profile.creatorCategory?' · '+profile.creatorCategory:''%></span><%}%></p><p><%=profile.bio%></p><%if(profile.creatorLink&&profile.proExpiresAt&&new Date(profile.proExpiresAt)>new Date()){ %><a class="pro-link" href="<%=profile.creatorLink%>" target="_blank" rel="noopener noreferrer nofollow"><i data-lucide="external-link"></i> Portfolio / havola</a><%}%><div class="profile-stats"><span><b><%=profile.postCount||posts.length%></b> post</span><span><b><%=profile.followers ?? profile.followerCount ?? 0%></b> <%=profile.accountOrigin==='synthetic'?'virtual follower':'follower'%></span><span><b><%=profile.following||profile.followingCount||0%></b> following</span></div>
  <div class="profile-quick-actions">
  <% if(own){ %>
    <a class="btn primary profile-action-main" href="/posts/create"><i data-lucide="square-plus"></i><span>Post</span></a>
    <a class="btn ghost profile-action-icon" href="/stories/create" aria-label="Story yaratish" title="Story yaratish"><i data-lucide="circle-plus"></i><span>Story</span></a>
    <a class="btn ghost profile-action-icon" href="/settings" aria-label="Sozlamalar" title="Sozlamalar"><i data-lucide="settings-2"></i></a>
    <details class="profile-action-menu"><summary class="btn ghost profile-action-icon" aria-label="Boshqa amallar" title="Boshqa amallar"><i data-lucide="ellipsis"></i></summary>
      <div class="profile-action-dropdown">
        <a href="/creator/analytics"><i data-lucide="chart-no-axes-combined"></i> Analitika</a><a href="/creator/program"><i data-lucide="gem"></i> Pro va monetizatsiya</a>
        <a href="/account"><i data-lucide="sliders-horizontal"></i> Creator va akkaunt</a>
        <a href="/saved"><i data-lucide="bookmark"></i> Saqlanganlar</a>
        <a href="/posts/drafts"><i data-lucide="file-clock"></i> Qoralamalar</a>
        <a href="/posts/archived"><i data-lucide="archive"></i> Post arxivi</a>
        <a href="/stories/archive/me"><i data-lucide="images"></i> Story arxivi</a>
        <button type="button" data-share-profile data-profile-url="/u/<%=profile.username%>" data-profile-title="<%=profile.name%> (@<%=profile.username%>)"><i data-lucide="share-2"></i> Ulashish</button>
      </div>
    </details>
  <% } else if(currentUser){ %>
    <form method="post" action="/u/<%=profile.username%>/follow" class="profile-follow-form"><button class="btn <%=isFollowing||followPending?'ghost':'primary'%> profile-action-main"><i data-lucide="<%=isFollowing?'user-check':followPending?'clock':'user-plus'%>"></i><span><%=isFollowing?'Bekor qilish':followPending?'So‘rovni bekor':'Obuna bo‘lish'%></span></button></form>
    <%if(isFollowing&&profile.allowMessages!=='nobody'){%><a class="btn ghost profile-action-icon" href="/chats/with/<%=profile.username%>" aria-label="Xabar" title="Xabar"><i data-lucide="message-circle"></i></a><%}%>
    <button class="btn ghost profile-action-icon" type="button" data-share-profile data-profile-url="/u/<%=profile.username%>" data-profile-title="<%=profile.name%> (@<%=profile.username%>)" aria-label="Ulashish" title="Ulashish"><i data-lucide="share-2"></i></button>
    <details class="profile-action-menu"><summary class="btn ghost profile-action-icon" aria-label="Boshqa amallar" title="Boshqa amallar"><i data-lucide="ellipsis"></i></summary><div class="profile-action-dropdown">
      <button type="button" data-user-relation="mute" data-username="<%=profile.username%>"><i data-lucide="volume-x"></i> Ovozsiz</button>
      <button type="button" data-user-relation="restrict" data-username="<%=profile.username%>"><i data-lucide="shield"></i> Cheklash</button>
      <button type="button" class="danger-text" data-user-relation="block" data-username="<%=profile.username%>"><i data-lucide="ban"></i> Bloklash</button>
      <button type="button" class="danger-text" data-user-report="<%=profile.username%>"><i data-lucide="flag"></i> Shikoyat qilish</button>
    </div></details>
  <% } else { %>
    <button class="btn primary profile-action-main" type="button" data-auth-required><i data-lucide="user-plus"></i><span>Obuna bo‘lish</span></button>
    <button class="btn ghost profile-action-icon" type="button" data-auth-required aria-label="Xabar yozish" title="Xabar yozish"><i data-lucide="message-circle"></i></button>
    <button class="btn ghost profile-action-icon" type="button" data-share-profile data-profile-url="/u/<%=profile.username%>" data-profile-title="<%=profile.name%> (@<%=profile.username%>)" aria-label="Ulashish" title="Ulashish"><i data-lucide="share-2"></i></button>
  <% } %>
  </div>
  </div>
</section>
<%if(adConfig?.enabled&&adConfig.profileEnabled&&(profileAds?.length||adConfig.networkEnabled)){%><section class="profile-ad-slot"><%if(profileAds?.length){const ad=profileAds[0];%><%- include('../partials/adcard',{ad,placement:'profile',variant:'banner',adConfig}) %><%}else{%><%- include('../partials/networkad',{placement:'profile',variant:'banner',adConfig}) %><%}%></section><%}%>
<%if(highlights&&highlights.length){%><section class="highlight-rail"><%highlights.forEach(h=>{%><a href="/stories/<%=profile.username%>" class="highlight-bubble"><span><img src="<%=h.thumbUrl||h.mediaUrl%>"></span><small><%=h.highlightTitle||'Highlight'%></small></a><%})%></section><%}%>
<%if(!canSee){%><section class="private-profile card"><i data-lucide="lock"></i><h2>Bu profil yopiq</h2><p>Post va Storylarni ko‘rish uchun obuna so‘rovini yuboring.</p></section><%}else{%><div class="profile-grid"><%posts.forEach(p=>{const m=(p.media&&p.media[0])||{url:p.imageUrl,type:'image'};%><a class="profile-tile" href="/p/<%=p._id%>" data-post-expires="<%=p.expiresAt?new Date(p.expiresAt).toISOString():''%>" data-view-track data-post-id="<%=p._id%>"><%if(m.type==='video'){%><%if(m.posterUrl||m.thumbUrl){%><img src="<%=m.posterUrl||m.thumbUrl%>" loading="lazy" alt="Video muqovasi"><%}else{%><video preload="none" muted></video><%}%><span class="tile-video"><i data-lucide="play"></i></span><%}else{%><img src="<%=m.thumbUrl||m.url%>" loading="lazy"><%}%><span><i data-lucide="heart"></i> <%=p.likeCount||0%> · <i data-lucide="eye"></i> <b data-view-count><%=p.viewCount||0%></b></span><%if(p.isPinned){%><b class="tile-pin"><i data-lucide="pin"></i></b><%}%></a><%})%></div><%}%></main><%- include('../partials/footer') %>
