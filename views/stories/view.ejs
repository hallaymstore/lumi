<!doctype html><html lang="uz"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#09070c"><title><%=title%> · Lumi</title><link rel="stylesheet" href="/css/app.css"><script src="https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js" defer></script></head><body class="story-viewer-body" data-current-user-id="<%=currentUser?._id||''%>"><main class="story-stage-shell"><div class="story-ambient" data-story-bg></div><section class="story-viewer" data-story-viewer data-owner="<%=isOwner?'1':'0'%>" data-profile="<%=profile.username%>" data-stories='<%=JSON.stringify(stories.map(s=>({id:String(s._id),url:s.mediaUrl,type:s.mediaType||"image",caption:s.caption||"",liked:!!s.likedByMe,likeCount:s.likeCount||0,viewCount:s.viewCount||0,linkUrl:s.linkUrl||"",stickers:s.stickers||[],poll:s.poll||null,isHighlight:!!s.isHighlight,highlightTitle:s.highlightTitle||"",musicUrl:s.musicUrl||""})))%>'><div class="story-progress" data-story-progress></div><div class="story-viewer-head"><a href="/u/<%=profile.username%>" class="user-line"><span class="avatar"><%if(profile.avatarUrl){%><img src="<%=profile.avatarUrl%>"><%}else{%><b><%=profile.name[0]%></b><%}%></span><span><strong><%=profile.name%> <%if(profile.isVerified){%><i class="verified" data-lucide="badge-check"></i><%}%></strong><small>@<%=profile.username%></small></span></a><button type="button" class="story-close" data-story-close><i data-lucide="x"></i></button></div><img data-story-image class="story-media" alt="Story"><video data-story-video class="story-media" playsinline muted hidden></video><audio data-story-music preload="metadata" hidden></audio><div class="story-shade"></div><div class="story-stickers" data-story-stickers></div><div class="story-caption" data-story-caption></div><a class="story-link-pill" data-story-link target="_blank" rel="noopener" hidden><i data-lucide="link"></i> Linkni ochish</a><div class="story-poll" data-story-poll hidden></div><div class="story-actions-modern"><%if(currentUser&&!isOwner&&profile.allowStoryReplies!==false){%><form class="story-reply-form" data-story-reply><input name="text" maxlength="600" autocomplete="off" placeholder="Storyga javob yozing…"><button><i data-lucide="send"></i></button></form><%}else if(isOwner){%><button type="button" class="story-viewers-btn" data-story-engagement><i data-lucide="users"></i><span><b data-story-view-count>0</b> ko‘rish · <b data-story-like-count>0</b> like</span></button><button type="button" class="story-highlight-btn" data-story-highlight><i data-lucide="star"></i></button><%}%><%if(currentUser&&!isOwner){%><button type="button" class="story-like-btn" data-story-like><i data-lucide="heart"></i><span data-story-like-count>0</span></button><%}%><%if(!currentUser){%><a class="story-guest-join" href="/register?next=/stories/<%=profile.username%>"><i data-lucide="user-plus"></i> Like va reply uchun qo‘shiling</a><%}%></div><div class="story-toast" data-story-toast hidden></div><button class="story-zone story-prev" data-story-prev></button><button class="story-zone story-next" data-story-next></button><button class="story-arrow story-arrow-left" data-story-prev-desktop><i data-lucide="chevron-left"></i></button><button class="story-arrow story-arrow-right" data-story-next-desktop><i data-lucide="chevron-right"></i></button></section></main><div class="story-engagement-sheet" data-story-engagement-sheet hidden><div class="story-engagement-card"><div class="sheet-grabber"></div><div class="sheet-title"><strong>Story faolligi</strong><button type="button" class="icon-btn" data-story-engagement-close><i data-lucide="x"></i></button></div><div class="engagement-tabs"><button class="active" data-engagement-tab="viewers">Ko‘rganlar <b data-engagement-view-count>0</b></button><button data-engagement-tab="likes">Like <b data-engagement-like-count>0</b></button></div><div class="engagement-list" data-engagement-list></div></div></div><script src="/js/story.js"></script></body></html>
