<%- include('../partials/head') %><%- include('../partials/topbar') %><main class="content story-create-page"><section class="story-editor card"><div class="story-editor-copy"><span class="story-editor-kicker"><i data-lucide="sparkles"></i> STORY STUDIO</span><h1>Story yarating</h1><p class="muted">Rasm/video, musiqa, poll, link, @mention, emoji sticker va Close Friends.</p><%if(error){%><div class="alert"><%=error%></div><%}%><form method="post" action="/stories/create" enctype="multipart/form-data" class="story-create-form"><label class="story-file-select"><i data-lucide="image-plus"></i><span><strong>Rasm yoki video</strong><small>JPG/PNG/WEBP/AVIF yoki MP4/WEBM</small></span><input data-image-input type="file" name="media" accept="image/*,video/mp4,video/webm" required></label><label class="story-file-select mini"><i data-lucide="music"></i><span><strong>Musiqa (ixtiyoriy)</strong><small>Audio fayl</small></span><input type="file" name="music" accept="audio/*"></label><label>Story yozuvi<textarea name="caption" maxlength="240" rows="3" placeholder="Bugungi kayfiyat ✨ @username" data-story-caption-input></textarea></label><label>Link<input type="url" name="linkUrl" placeholder="https://..."></label><label>Emoji stickerlar<input name="stickers" maxlength="120" placeholder="✨, 💗, 🌸"></label><div class="story-poll-builder"><b>Poll (ixtiyoriy)</b><input name="pollQuestion" maxlength="100" placeholder="Qaysi biri?"><div><input name="pollA" maxlength="40" placeholder="Variant A"><input name="pollB" maxlength="40" placeholder="Variant B"></div></div><label>Kim ko‘radi?<select name="audience"><option value="everyone">Hamma</option><option value="followers">Followerlar</option><option value="close_friends">Close Friends</option></select></label><div class="story-editor-actions"><a class="btn ghost" href="/feed">Bekor</a><button class="btn primary"><i data-lucide="send"></i> Story joylash</button></div></form></div><div class="story-compose-device"><div class="story-compose-preview" data-preview><img class="story-compose-media" data-preview-image alt="Preview" hidden><div class="story-compose-placeholder" data-preview-placeholder><i data-lucide="image"></i><strong>Story preview</strong><small>Media tanlang</small></div><div class="story-compose-chrome"><div class="story-compose-bars"><i></i><i></i><i></i></div><div class="story-compose-user"><span class="avatar"><%if(currentUser.avatarUrl){%><img src="<%=currentUser.avatarUrl%>"><%}else{%><b><%=currentUser.name[0]%></b><%}%></span><div><strong><%=currentUser.name%></strong><small>hozir</small></div></div></div><div class="story-compose-caption" data-story-caption-preview></div></div></div></section></main><%- include('../partials/footer') %>
