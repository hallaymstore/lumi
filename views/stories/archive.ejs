<%- include('../partials/head') %><%- include('../partials/topbar') %><main class="content narrow"><div class="page-title-row"><div><h1>Story arxivi</h1><p class="muted">24 soatdan o‘tgan storylar. Highlightga qo‘shilganlari profilda ko‘rinadi.</p></div><a class="btn ghost" href="/u/<%=currentUser.username%>">Profil</a></div><div class="archive-grid"><%if(!stories.length){%><div class="empty card">Arxiv hozircha bo‘sh.</div><%}%><%stories.forEach(s=>{%><article class="archive-story card"><img src="<%=s.thumbUrl||s.mediaUrl%>"><div><p><%=s.caption||'Story'%></p><small><%=new Date(s.createdAt).toLocaleDateString('uz-UZ')%></small><button class="btn <%=s.isHighlight?'primary':'ghost'%>" type="button" data-highlight-story="<%=s._id%>"><i data-lucide="star"></i> <%=s.isHighlight?'Highlightda':'Highlightga qo‘shish'%></button></div></article><%})%></div></main><%- include('../partials/footer') %>
