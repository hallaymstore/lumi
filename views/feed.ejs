<%- include('partials/head') %><%- include('partials/topbar') %>
<main class="content feed-layout"><section class="feed-column" data-feed-column data-feed-nonce="<%=feedNonce%>">
  <div class="feed-tabs glass"><a class="<%=feedMode==='foryou'?'active':''%>" href="/feed?tab=foryou">For You</a><a class="<%=feedMode==='following'?'active':''%>" href="/feed?tab=following">Following</a><a class="<%=feedMode==='new'?'active':''%>" href="/feed?tab=new">Yangi</a></div>
  <% if(freshPostsEnabled){ %><div class="card" style="padding:10px 14px;display:flex;align-items:center;gap:10px"><i data-lucide="timer" style="color:var(--primary,#f45)"></i><div><b>Fresh 24h</b><div class="muted tiny">Har kun yangi kontent. Fresh postlar 24 soatdan keyin yo‘qoladi.</div></div></div><% } %>
  <% if(!currentUser){ %><div class="guest-banner card"><span><i data-lucide="sparkles"></i></span><div><b>Lumi’ni erkin tomosha qiling</b><p>Guest ko‘rishlar ham hisoblanadi. Like, comment, follow va chat uchun hisob kerak.</p></div><a class="btn primary" href="/register">Qo‘shilish</a></div><% } %>
  <%- include('partials/storystrip', { storyPeople }) %>
  <% if(!posts.length){ %><div class="empty card"><i data-lucide="image-plus"></i><h2>Bu bo‘lim hali bo‘sh</h2><p><%=feedMode==='following'?'Obuna bo‘lgan creatorlaringiz postlari shu yerda chiqadi.':'Birinchi postni joylash uchun Lumi’ga qo‘shiling ✨'%></p><a class="btn primary" href="<%= currentUser ? '/explore' : '/register' %>"><%= currentUser ? 'Creator topish' : 'Ro‘yxatdan o‘tish' %></a></div><% } %>
  <div class="feed-posts" data-feed-posts><%- include('partials/feedposts', { posts, adConfig, adSlots, firstPage: true }) %></div>
  <div class="feed-more" data-feed-more data-feed-tab="<%=feedMode%>" data-feed-nonce="<%=feedNonce%>" data-feed-has-more="<%=hasMorePosts?'1':'0'%>">
    <div class="feed-skeleton" data-feed-skeleton hidden aria-hidden="true"><div class="sk-head"></div><div class="sk-media"></div><div class="sk-line"></div></div>
    <div class="feed-end" data-feed-error hidden><i data-lucide="wifi-off"></i><b>Ulanishda muammo</b><span>Internetni tekshirib, qayta urinib ko‘ring</span><button type="button" class="btn ghost" data-feed-retry>Qayta urinish</button></div>
    <div class="feed-end" data-feed-end <%=hasMorePosts||!posts.length?'hidden':''%>><i data-lucide="sparkles"></i><b>Hozircha hammasi shu</b><span>Yangi postlar uchun Feed tugmasini qayta bosing</span><a class="btn ghost" href="/feed?tab=<%=feedMode%>&refresh=<%=Date.now()%>">Yangilash</a></div>
  </div>
</section>
<aside class="desktop-side card">
  <h3>Lumi ✦ For You</h3>
  <p class="muted">Feed va reklama oqimi qiziqishlar, engagement, dwell time, save/share va frequency-cap signallari asosida muvozanatlanadi.</p>
  <a href="/explore" class="mini-link">Yangi creatorlarni topish →</a>
  <% if(currentUser){ %><a href="/creator/analytics" class="mini-link side-link"><i data-lucide="chart-no-axes-combined"></i> Creator Analytics</a><a href="/saved" class="mini-link side-link"><i data-lucide="bookmark"></i> Saqlanganlar</a><% } %>
  <%if(adConfig?.enabled&&adConfig.networkEnabled&&posts.length>=8){%><div class="feed-sidebar-ad"><%- include('partials/networkad',{placement:'feed',variant:'sidebar',adConfig}) %></div><%}%>
</aside></main>
<%- include('partials/postsheets', { shareTargets }) %><%- include('partials/footer') %>
