<% const isLogged=!!currentUser; const liked=!!p.likedByMe; const saved=!!p.savedByMe; const media=(p.media&&p.media.length?p.media:[{url:p.imageUrl,type:'image'}]); const ownPost=isLogged&&String(p.author._id)===String(currentUser._id);  const isEager=typeof eager!=='undefined'&&!!eager; const MONTHS=['yan','fev','mar','apr','may','iyn','iyl','avg','sen','okt','noy','dek']; const ago=d=>{const t=new Date(d).getTime();if(!t)return '';const sec=Math.max(1,Math.floor((Date.now()-t)/1000));if(sec<60)return 'hozirgina';const m=Math.floor(sec/60);if(m<60)return m+' daqiqa oldin';const h=Math.floor(m/60);if(h<24)return h+' soat oldin';const dd=Math.floor(h/24);if(dd<7)return dd+' kun oldin';const x=new Date(t);return x.getDate()+' '+MONTHS[x.getMonth()]+(x.getFullYear()!==new Date().getFullYear()?' '+x.getFullYear():'')}; %>
<article class="post-card card" data-post-id="<%=p._id%>" data-view-track data-post-author="<%=p.author?._id||''%>">
  <div class="post-head"><a class="user-line" href="/u/<%=p.author.username%>"><span class="avatar"><img src="<%=p.author.avatarUrl||'/icons/icon-192.png'%>" class="<%=p.author.avatarUrl?'':'avatar-fallback'%>" alt=""></span><span><strong><%=p.author.name%> <%if(p.author.isVerified){%><i class="verified" data-lucide="badge-check"></i><%}%> <%if(p.author.proExpiresAt&&new Date(p.author.proExpiresAt)>new Date()&&p.author.accountOrigin!=='synthetic'){%><span class="lumi-pro-badge">✦ Pro</span><%}%></strong><small>@<%=p.author.username%> <%if(p.author.accountOrigin==='synthetic'){%>· Virtual profile<%}%></small></span></a>
    <div class="post-menu" data-post-menu><button class="icon-btn post-menu-trigger" type="button" data-post-menu-toggle aria-haspopup="true" aria-expanded="false" aria-label="Post menyusi"><i data-lucide="ellipsis"></i></button><div class="post-menu-pop" role="group" aria-label="Post amallari" hidden><a href="/p/<%=p._id%>"><i data-lucide="link"></i> Post sahifasi</a><button type="button" data-share-open="<%=p._id%>"><i data-lucide="send"></i> Ulashish</button><%if(isLogged&&!ownPost){%><button type="button" data-not-interested="<%=p._id%>"><i data-lucide="eye-off"></i> Qiziq emas</button><button type="button" data-hide-author="<%=p._id%>"><i data-lucide="user-round-x"></i> @<%=p.author.username%> postlarini kamaytirish</button><form method="post" action="/posts/<%=p._id%>/report"><input type="hidden" name="reason" value="other"><button><i data-lucide="flag"></i> Report</button></form><%}%><%if(ownPost){%><a href="/posts/<%=p._id%>/edit"><i data-lucide="pencil"></i> Tahrirlash</a><form method="post" action="/posts/<%=p._id%>/pin"><button><i data-lucide="pin"></i> <%=p.isPinned?'Unpin':'Profilga pin'%></button></form><form method="post" action="/posts/<%=p._id%>/archive"><button><i data-lucide="archive"></i> Arxivlash</button></form><form method="post" action="/posts/<%=p._id%>/delete"><button class="danger-text"><i data-lucide="trash-2"></i> O‘chirish</button></form><%}%></div></div>
  </div>
  <div class="post-carousel" data-carousel><div class="post-carousel-track" data-carousel-track>
    <% media.forEach((m,idx)=>{ %>
      <% if(m.type==='video'){ %>
        <div class="post-image-wrap lumi-video-player" data-lumi-video data-video-post="<%=p._id%>">
          <video class="post-image lumi-video-media" data-video-src="<%=m.playbackUrl||m.url%>" poster="<%=m.posterUrl||m.thumbUrl||''%>" muted playsinline preload="none" loop aria-label="@<%=p.author.username%> videosi"><%if(m.captionsUrl){%><track kind="captions" label="Subtitr" srclang="<%=m.captionsLang||'uz'%>" src="/api/clips/caption/<%=p._id%>?i=<%=idx%>"><%}%></video>
          <button type="button" class="lumi-video-bigplay" data-video-toggle aria-label="Videoni o‘ynatish"><i data-lucide="play"></i></button>
          <div class="lumi-video-controls" aria-label="Video boshqaruvi">
            <button class="lumi-video-control lumi-video-toggle" type="button" data-video-toggle aria-label="Pauza yoki ijro"><i class="lumi-play-icon" data-lucide="play"></i><i class="lumi-pause-icon" data-lucide="pause"></i></button>
            <span class="lumi-video-time" data-video-time>0:00</span>
            <input class="lumi-video-seek" type="range" min="0" max="1000" value="0" step="1" data-video-seek aria-label="Videoni oldinga yoki orqaga surish">
            <button class="lumi-video-control lumi-video-mute" type="button" data-video-mute aria-label="Ovoz"><i class="lumi-sound-off" data-lucide="volume-x"></i><i class="lumi-sound-on" data-lucide="volume-2"></i></button>
            <button class="lumi-video-control" type="button" data-video-captions <%=m.captionsUrl?'':'disabled'%> aria-label="Subtitr"><i data-lucide="captions"></i></button>
            <button class="lumi-video-control lumi-video-speed" type="button" data-video-speed aria-label="Ijro tezligi">1×</button>
            <button class="lumi-video-control" type="button" data-video-pip aria-label="Mini pleyer"><i data-lucide="picture-in-picture-2"></i></button>
            <button class="lumi-video-control" type="button" data-video-fullscreen aria-label="To‘liq ekran"><i data-lucide="maximize"></i></button>
          </div>
        </div>
      <% } else { %>
        <div class="post-image-wrap post-image-link" style="aspect-ratio:<%=Math.min(1.25,Math.max(.8,(m.width&&m.height)?m.width/m.height:.8)).toFixed(3)%>"><img class="post-image" src="<%=m.thumbUrl||m.url%>" srcset="<%=m.thumbUrl&&m.url!==m.thumbUrl ? m.thumbUrl+' 360w, '+m.url+' 1400w' : ''%>" sizes="(max-width: 650px) 100vw, 560px" <%=m.width&&m.height?'width="'+m.width+'" height="'+m.height+'"':''%> alt="<%=(p.caption||('@'+p.author.username+' posti')).slice(0,100)%>" <%-isEager&&idx===0?'loading="eager" fetchpriority="high"':'loading="lazy"'%> decoding="async" draggable="false" data-double-like></div>
      <% } %>
    <% }) %>
  </div><%if(media.length>1){%><button class="carousel-arrow left" type="button" data-carousel-prev aria-label="Oldingi media"><i data-lucide="chevron-left"></i></button><button class="carousel-arrow right" type="button" data-carousel-next aria-label="Keyingi media"><i data-lucide="chevron-right"></i></button><div class="carousel-dots"><%media.forEach((m,i)=>{%><i class="<%=i===0?'active':''%>"></i><%})%></div><span class="carousel-count">1/<%=media.length%></span><%}%></div>
  <div class="post-actions"><div><%if(isLogged){%><form class="inline ajax-like-form" method="post" action="/posts/<%=p._id%>/like"><button class="action-btn <%=liked?'liked':''%>" aria-label="Like"><i data-lucide="heart"></i></button></form><%}else{%><button class="action-btn" type="button" data-auth-required><i data-lucide="heart"></i></button><%}%><button class="action-btn" type="button" data-comments-open="<%=p._id%>"><i data-lucide="message-circle"></i></button><button class="action-btn" type="button" data-share-open="<%=p._id%>"><i data-lucide="send"></i></button></div><div><%if(isLogged){%><button class="action-btn <%=saved?'saved':''%>" type="button" data-save-post="<%=p._id%>" title="Saqlash"><i data-lucide="bookmark"></i></button><%}else{%><button class="action-btn" type="button" data-auth-required><i data-lucide="bookmark"></i></button><%}%></div></div>
  <div class="post-body"><div class="post-metrics"><button class="like-count-link" type="button" data-post-likes-open="<%=p._id%>"><strong><span data-like-count><%=p.likeCount||0%></span> <%=p.author.accountOrigin==='synthetic'?'virtual likes':'likes'%></strong></button><span class="view-count"><i data-lucide="eye"></i><b data-view-count><%=p.viewCount||0%></b> <%=p.author.accountOrigin==='synthetic'?'virtual ko‘rish':'ko‘rish'%></span></div><p><b><a href="/u/<%=p.author.username%>"><%=p.author.username%></a></b> <%-p.captionHtml||p.caption||''%></p><a class="post-time" href="/p/<%=p._id%>"><time datetime="<%=new Date(p.createdAt).toISOString()%>"><%=ago(p.createdAt)%></time></a><%if(p.editedAt){%><small class="muted tiny"> · tahrirlangan</small><%}%><%if(p.tags&&p.tags.length){%><p class="tags"><%=p.tags.map(t=>'#'+t).join(' ')%></p><%}%><button type="button" class="comments-summary" data-comments-open="<%=p._id%>"><%=p.commentCount?`${p.commentCount} ta ${p.author.accountOrigin==='synthetic'?'virtual ':''}commentni ko‘rish`:'Commentlarni ko‘rish'%></button></div>
</article>
