<% const isLogged=!!currentUser; const liked=!!p.likedByMe; const saved=!!p.savedByMe; const media=(p.media&&p.media.length?p.media:[{url:p.imageUrl,type:'image'}]); %>
<article class="post-card card" data-post-id="<%=p._id%>" data-view-track data-post-author="<%=p.author?._id||''%>">
  <div class="post-head"><a class="user-line" href="/u/<%=p.author.username%>"><span class="avatar"><%if(p.author.avatarUrl){%><img src="<%=p.author.avatarUrl%>" alt=""><%}else{%><b><%=p.author.name[0]%></b><%}%></span><span><strong><%=p.author.name%> <%if(p.author.isVerified){%><i class="verified" data-lucide="badge-check"></i><%}%></strong><small>@<%=p.author.username%></small></span></a>
    <details class="post-menu"><summary class="icon-btn"><i data-lucide="ellipsis"></i></summary><div class="post-menu-pop"><a href="/p/<%=p._id%>"><i data-lucide="link"></i> Post sahifasi</a><button type="button" data-share-open="<%=p._id%>"><i data-lucide="send"></i> Ulashish</button><%if(isLogged&&String(p.author._id)!==String(currentUser._id)){%><button type="button" data-not-interested="<%=p._id%>"><i data-lucide="eye-off"></i> Qiziq emas</button><button type="button" data-hide-author="<%=p._id%>"><i data-lucide="user-round-x"></i> @<%=p.author.username%> postlarini kamaytirish</button><form method="post" action="/posts/<%=p._id%>/report"><input type="hidden" name="reason" value="other"><button><i data-lucide="flag"></i> Report</button></form><%}%><%if(isLogged&&String(p.author._id)===String(currentUser._id)){%><form method="post" action="/posts/<%=p._id%>/pin"><button><i data-lucide="pin"></i> <%=p.isPinned?'Unpin':'Profilga pin'%></button></form><%}%></div></details>
  </div>
  <div class="post-carousel" data-carousel><div class="post-carousel-track" data-carousel-track><%media.forEach((m,idx)=>{%><a class="post-image-wrap post-image-link" href="/p/<%=p._id%>"><%if(m.type==='video'){%><video class="post-image" src="<%=m.url%>" muted playsinline preload="metadata" controls></video><%}else{%><img class="post-image" src="<%=m.url%>" alt="<%=(p.caption||('@'+p.author.username+' posti')).slice(0,100)%>" loading="lazy" data-double-like><%}%></a><%})%></div><%if(media.length>1){%><button class="carousel-arrow left" type="button" data-carousel-prev><i data-lucide="chevron-left"></i></button><button class="carousel-arrow right" type="button" data-carousel-next><i data-lucide="chevron-right"></i></button><div class="carousel-dots"><%media.forEach((m,i)=>{%><i class="<%=i===0?'active':''%>"></i><%})%></div><span class="carousel-count">1/<%=media.length%></span><%}%></div>
  <div class="post-actions"><div><%if(isLogged){%><form class="inline ajax-like-form" method="post" action="/posts/<%=p._id%>/like"><button class="action-btn <%=liked?'liked':''%>" aria-label="Like"><i data-lucide="heart"></i></button></form><%}else{%><button class="action-btn" type="button" data-auth-required><i data-lucide="heart"></i></button><%}%><button class="action-btn" type="button" data-comments-open="<%=p._id%>"><i data-lucide="message-circle"></i></button><button class="action-btn" type="button" data-share-open="<%=p._id%>"><i data-lucide="send"></i></button></div><div><%if(isLogged){%><button class="action-btn <%=saved?'saved':''%>" type="button" data-save-post="<%=p._id%>"><i data-lucide="bookmark"></i></button><%}else{%><button class="action-btn" type="button" data-auth-required><i data-lucide="bookmark"></i></button><%}%></div></div>
  <div class="post-body"><div class="post-metrics"><button class="like-count-link" type="button" data-post-likes-open="<%=p._id%>"><strong><span data-like-count><%=p.likeCount||0%></span> likes</strong></button><span class="view-count"><i data-lucide="eye"></i><b data-view-count><%=p.viewCount||0%></b> ko‘rish</span></div><p><b><a href="/u/<%=p.author.username%>"><%=p.author.username%></a></b> <%-p.captionHtml||p.caption||''%></p><%if(p.tags&&p.tags.length){%><p class="tags"><%=p.tags.map(t=>'#'+t).join(' ')%></p><%}%><button type="button" class="comments-summary" data-comments-open="<%=p._id%>"><%=p.commentCount?`${p.commentCount} ta commentni ko‘rish`:'Commentlarni ko‘rish'%></button></div>
</article>
