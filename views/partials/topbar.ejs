<header class="topbar glass">
  <a class="brand" href="/feed"><span class="brand-orb">L</span><span>Lumi</span></a>
  <div class="top-actions">
    <a class="icon-btn" href="/clips" aria-label="Lumi Clips" title="Lumi Clips"><i data-lucide="clapperboard"></i></a>
    <a class="icon-btn top-extra" href="/trending" aria-label="Trendlar"><i data-lucide="flame"></i></a>
    <a class="icon-btn" href="/explore" aria-label="Qidirish"><i data-lucide="search"></i></a>
    <button class="icon-btn" data-theme-toggle aria-label="Tungi rejim"><i data-lucide="moon"></i></button>
    <% if (currentUser) { %>
      <a class="icon-btn top-extra" href="/creator/program" title="Lumi Pro va monetizatsiya" aria-label="Lumi Pro"><i data-lucide="gem"></i></a>
      <% if(!(currentUser.interests||[]).length){ %><a class="icon-btn interest-nudge top-extra" href="/onboarding/interests?next=<%=encodeURIComponent(path||'/feed')%>" aria-label="For You qiziqishlarini tanlash" title="For You sozlash"><i data-lucide="sparkles"></i></a><% } %>
      <a class="icon-btn top-extra" href="/account" aria-label="Akkaunt markazi" title="Akkaunt markazi"><i data-lucide="sliders-horizontal"></i></a>
      <div class="top-more" data-top-more><button class="icon-btn" type="button" data-top-more-toggle aria-haspopup="true" aria-expanded="false" aria-label="Yana"><i data-lucide="layout-grid"></i></button><div class="top-more-panel" hidden><a href="/trending"><i data-lucide="flame"></i> Trendlar</a><a href="/creator/program"><i data-lucide="gem"></i> Lumi Pro</a><a href="/account"><i data-lucide="sliders-horizontal"></i> Akkaunt markazi</a></div></div>
      <a class="icon-btn top-badge-anchor" href="/notifications" aria-label="Bildirishnomalar"><i data-lucide="bell"></i><b class="top-badge" data-notification-badge <%= unreadNotifications ? '' : 'hidden' %>><%= unreadNotifications > 99 ? '99+' : unreadNotifications %></b></a>
      <% if(currentUser.role === 'admin'){ %><a class="icon-btn admin-top-btn" href="/admin" aria-label="Admin"><i data-lucide="shield-check"></i></a><% } %>
      <a class="avatar-mini" href="/u/<%= currentUser.username %>" aria-label="Profil"><img src="<%=currentUser.avatarUrl||'/icons/icon-192.png'%>" class="<%=currentUser.avatarUrl?'':'avatar-fallback'%>" alt=""></a>
    <% } else { %>
      <a class="top-login-link" href="/login?next=<%= encodeURIComponent(path || '/feed') %>">Kirish</a>
      <a class="btn primary top-register-btn" href="/register?next=<%= encodeURIComponent(path || '/feed') %>">Ro‘yxatdan o‘tish</a>
    <% } %>
  </div>
</header>
