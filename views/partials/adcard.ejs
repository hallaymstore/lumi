<% const compactAd = variant === 'compact' || variant === 'banner'; %>
<article class="ad-card <%=compactAd?'ad-compact':'ad-native'%> <%=variant==='banner'?'ad-banner':''%>" data-ad-card data-ad-id="<%=ad._id%>" data-ad-placement="<%=placement%>" data-ad-delay="<%=adConfig.ctaDelaySeconds||3%>">
  <header class="ad-head">
    <span class="ad-avatar"><b><%=(ad.advertiserName||'A').charAt(0).toUpperCase()%></b><i data-lucide="globe-2"></i></span>
    <span class="ad-identity"><strong><%=ad.advertiserName%></strong><small><%=ad.domain%></small></span>
    <span class="ad-sponsored"><i data-lucide="badge-info"></i> <%=adConfig.label||'Reklama'%></span>
    <button type="button" class="ad-close" data-ad-dismiss aria-label="Reklamani yopish"><i data-lucide="x"></i></button>
  </header>
  <div class="ad-content">
    <div class="ad-image-wrap"><img class="ad-image" src="<%=ad.thumbUrl||ad.imageUrl%>" alt="<%=ad.title%>" loading="lazy"><span><i data-lucide="sparkles"></i> Tavsiya etiladi</span></div>
    <div class="ad-copy"><h3><%=ad.title%></h3><%if(ad.body){%><p><%=ad.body%></p><%}%>
      <div class="ad-cta-row">
        <span class="ad-domain"><i data-lucide="link-2"></i> <%=ad.domain%></span>
        <span class="ad-wait" data-ad-wait><i data-lucide="eye"></i> <b data-ad-countdown><%=adConfig.ctaDelaySeconds||3%></b>s</span>
        <a class="ad-cta" data-ad-cta hidden href="/ads/<%=ad._id%>/go?placement=<%=placement%>" target="_blank" rel="nofollow sponsored noopener noreferrer"><%=ad.ctaText||"Saytga o'tish"%> <i data-lucide="arrow-up-right"></i></a>
      </div>
    </div>
  </div>
</article>
