<div class="sheet-backdrop" data-comments-sheet hidden><section class="bottom-sheet comments-sheet" role="dialog" aria-modal="true" aria-label="Comments"><div class="sheet-grabber"></div><div class="sheet-title"><strong>Comments</strong><button class="icon-btn" type="button" data-sheet-close><i data-lucide="x"></i></button></div><div class="comments-scroll" data-comments-list><div class="sheet-loading">Yuklanmoqda…</div></div>
<% if(currentUser){ %><div class="reply-banner" data-reply-banner hidden><span data-reply-label></span><button type="button" data-reply-cancel><i data-lucide="x"></i></button></div><form class="sheet-composer" data-comment-form><input type="hidden" name="replyToComment" data-reply-id><input name="text" maxlength="400" autocomplete="off" placeholder="Comment yozing…" required><button class="send-circle" aria-label="Yuborish"><i data-lucide="send"></i></button></form><% } else { %><button type="button" class="guest-comment-cta" data-auth-required><i data-lucide="message-circle"></i><span><b>Comment yozmoqchimisiz?</b><small>Hisobga kiring yoki ro‘yxatdan o‘ting</small></span><i data-lucide="chevron-right"></i></button><% } %>
</section></div>

<div class="sheet-backdrop" data-share-sheet hidden><section class="bottom-sheet share-sheet" role="dialog" aria-modal="true" aria-label="Post ulashish"><div class="sheet-grabber"></div><div class="sheet-title"><strong>Postni ulashish</strong><button class="icon-btn" type="button" data-sheet-close><i data-lucide="x"></i></button></div>
<div class="external-share-grid">
  <button type="button" class="external-share native" data-native-share><span><i data-lucide="share-2"></i></span><small>Ulashish</small></button>
  <button type="button" class="external-share copy" data-copy-post-link><span><i data-lucide="link-2"></i></span><small>Link</small></button>
  <button type="button" class="external-share telegram" data-external-share="telegram"><span><i data-lucide="send"></i></span><small>Telegram</small></button>
  <button type="button" class="external-share whatsapp" data-external-share="whatsapp"><span><i data-lucide="message-circle"></i></span><small>WhatsApp</small></button>
  <button type="button" class="external-share xshare" data-external-share="x"><span>𝕏</span><small>X</small></button>
</div>
<% if(currentUser){ %><div class="share-divider"><span>yoki Lumi ichida</span></div><div class="share-targets"><% if(!shareTargets.length){ %><div class="empty-mini">Hali chatlar yo‘q. Profilga obuna bo‘lib, xabar yozishni boshlang.</div><% } %><% shareTargets.forEach(t=>{ %><button type="button" class="share-person" data-share-conversation="<%= t.conversationId %>"><span class="avatar"><% if(t.user.avatarUrl){%><img src="<%=t.user.avatarUrl%>"><%}else{%><b><%=t.user.name[0]%></b><%}%></span><span><strong><%=t.user.name%></strong><small>@<%=t.user.username%></small></span><i data-lucide="send"></i></button><% }) %></div><% } else { %><div class="share-login-hint"><i data-lucide="users"></i><span>Lumi ichida do‘stga yuborish uchun <button type="button" data-auth-required>hisobga kiring</button>.</span></div><% } %><div class="share-success" data-share-success hidden>Yuborildi ✓</div></section></div>

<div class="sheet-backdrop" data-likes-sheet hidden><section class="bottom-sheet people-sheet" role="dialog" aria-modal="true" aria-label="Like bosganlar"><div class="sheet-grabber"></div><div class="sheet-title"><strong>Like bosganlar</strong><button class="icon-btn" type="button" data-sheet-close><i data-lucide="x"></i></button></div><div class="people-list" data-likes-list></div></section></div>
