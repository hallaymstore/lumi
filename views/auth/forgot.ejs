<%- include('../partials/head') %><%- include('../partials/topbar') %><main class="auth-page"><section class="auth-card card"><h1>Parolni tiklash</h1><p class="muted">Telefon orqali xavfsiz tiklash.</p><%if(error){%><div class="alert"><%=error%></div><%}%><%if(step==='phone'){%><form method="post" action="/forgot-password" class="auth-form"><label>Telefon<input name="phone" data-phone-input inputmode="tel" placeholder="+998 90 123 45 67" required></label><button class="btn primary full">Kod yuborish</button></form><%}else{%><form method="post" action="/forgot-password/reset" class="auth-form"><label>Kod<input name="code" inputmode="numeric" maxlength="6" required></label><label>Yangi parol<input name="password" type="password" minlength="8" required></label><button class="btn primary full">Parolni yangilash</button></form><%}%><a class="mini-link" href="/login">Kirishga qaytish</a></section></main><%- include('../partials/footer') %>
