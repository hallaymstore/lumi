<%- include('../partials/head') %><%- include('../partials/topbar') %>
<main class="auth-wrap"><form class="card form-card" method="post" action="/login">
  <div class="form-icon"><i data-lucide="heart"></i></div><h1>Xush kelibsiz</h1><p class="muted">Telefon raqamingiz bilan tez va sodda kiring.</p>
  <% if(error){ %><div class="alert"><%= error %></div><% } %><input type="hidden" name="next" value="<%= next %>">
  <label>Telefon raqam<input type="tel" name="phone" required data-phone-input autocomplete="tel" inputmode="tel" placeholder="+998 90 123 45 67"></label>
  <label>Parol<input type="password" name="password" required autocomplete="current-password"></label>
  <button class="btn primary full">Kirish</button><p class="form-foot">Yangi foydalanuvchi? <a href="/register">Ro‘yxatdan o‘ting</a></p>
  <p class="tiny muted">Oldingi Lumi akkauntlari uchun shu maydonga email kiritish ham ishlaydi.</p>
</form></main><%- include('../partials/footer') %>
