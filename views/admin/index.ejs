<%- include('../partials/head') %><%- include('../partials/topbar') %>
<main class="content admin-page-v15">
  <div class="admin-hero"><div><span class="settings-kicker">LUMI CONTROL CENTER · v1.7</span><h1>Admin panel</h1><p>Moderatsiya, foydalanuvchilar, engagement, Feed signallari va tizim holati.</p></div><div class="admin-hero-actions"><a class="btn primary" href="/admin/ads"><i data-lucide="badge-dollar-sign"></i> Reklama markazi</a><a class="btn ghost" href="/feed"><i data-lucide="arrow-left"></i> Platformaga qaytish</a></div></div>
  <section class="admin-health-grid">
    <article class="health-card <%=system.mongo?'ok':'bad'%>"><i data-lucide="database"></i><div><b>MongoDB</b><small><%=system.mongo?'Ulangan':'Uzilgan'%></small></div></article>
    <article class="health-card <%=system.r2?'ok':'warn'%>"><i data-lucide="cloud"></i><div><b>Cloudflare R2</b><small><%=system.r2?'Sozlangan':'ENV tekshiring'%></small></div></article>
    <article class="health-card <%=system.redis?'ok':'warn'%>"><i data-lucide="radio-tower"></i><div><b>Redis Realtime</b><small><%=system.redis?'Multi-instance tayyor':'Local SSE fallback'%></small></div></article>
    <article class="health-card <%=system.push?'ok':'warn'%>"><i data-lucide="bell-ring"></i><div><b>Web Push</b><small><%=system.push?'VAPID faol':'VAPID keys kerak'%></small></div></article>
    <article class="health-card <%=system.otp?'ok':'warn'%>"><i data-lucide="smartphone"></i><div><b>Telefon OTP</b><small><%=system.otp?'Majburiy':'Development mode'%></small></div></article>
    <article class="health-card"><i data-lucide="globe-2"></i><div><b>Public URL</b><small><%=system.siteUrl%></small></div></article>
  </section>
  <section class="admin-stat-grid">
    <% const cards=[['users','Jami user','users',`${stats.newToday} bugun · ${stats.newWeek} 7 kunda`],['image','Postlar','posts',`${stats.postsToday} bugun · ${stats.hiddenPosts} yashirin`],['eye','Ko‘rishlar','views','unique user + guest'],['heart','Like','likes',`${stats.comments} comment`],['bookmark','Save','saves',`${stats.shares} ulashish`],['circle-play','Active story','activeStories','24 soat ichida'],['messages-square','Xabarlar','messages',`${stats.conversations} suhbat`],['flag','Moderatsiya','reportsOpen',`${stats.suspendedUsers} suspended`]]; %>
    <% cards.forEach(c=>{ %><article class="admin-stat"><span class="admin-stat-icon"><i data-lucide="<%=c[0]%>"></i></span><div><small><%=c[1]%></small><b><%=Number(stats[c[2]]||0).toLocaleString('uz-UZ')%></b><em><%=c[3]%></em></div></article><% }) %>
  </section>
  <div class="admin-two-col" id="moderation">
    <section class="admin-panel card"><div class="admin-panel-head"><div><span class="settings-kicker">MODERATION QUEUE</span><h2>Reportlar</h2></div><b class="admin-count"><%=flagged.length%></b></div>
      <div class="admin-list-v15"><%if(!flagged.length){%><div class="admin-empty"><i data-lucide="shield-check"></i><b>Navbat toza</b><small>Hozir ochiq report yo‘q.</small></div><%}%>
      <%flagged.forEach(r=>{%><article class="admin-post-row"><div class="admin-report-icon"><i data-lucide="flag"></i></div><div><b><%=r.targetType%> · <%=r.reason%></b><p><%=r.details||'Qo‘shimcha izoh yo‘q'%></p><small>Reporter: @<%=r.reporter?.username||'user'%> · Target: @<%=r.reportedUser?.username||'user'%></small></div><div class="admin-actions"><form method="post" action="/admin/reports/<%=r._id%>/action"><select name="action"><option value="dismiss">Dismiss</option><option value="hide_content">Kontentni yashirish</option><option value="warn">Ogohlantirish</option><option value="suspend_24h">Suspend 24h</option><option value="suspend_7d">Suspend 7 kun</option><option value="ban">Permanent ban</option></select><button class="btn danger">Qo‘llash</button></form></div></article><%})%></div>
    </section>
    <section class="admin-panel card"><div class="admin-panel-head"><div><span class="settings-kicker">FEED SIGNALS · 7 DAYS</span><h2>Algoritm signallari</h2></div></div><div class="admin-log-list"><%eventAgg.forEach(e=>{%><div><span><i data-lucide="activity"></i></span><p><b><%=e._id%></b><small><%=e.count%> event · value <%=Math.round(e.value||0)%></small></p></div><%})%></div></section>
  </div>
  <section class="admin-panel card admin-users-panel"><div class="admin-panel-head"><div><span class="settings-kicker">USERS</span><h2>Foydalanuvchilar</h2></div></div><form class="admin-filter" method="get"><div><i data-lucide="search"></i><input name="q" value="<%=q%>" placeholder="Ism, username yoki telefon"></div><select name="status"><option value="all">Barchasi</option><option value="active">Faol</option><option value="suspended">Suspended</option><option value="verified">Verified</option><option value="creator">Creator</option></select><button class="btn primary">Filtrlash</button></form><div class="admin-user-table"><%userResults.forEach(u=>{%><article class="admin-user-row"><a class="admin-user-ident" href="/u/<%=u.username%>"><span class="avatar"><%if(u.avatarUrl){%><img src="<%=u.avatarUrl%>"><%}else{%><b><%=u.name[0]%></b><%}%></span><span><strong><%=u.name%></strong><small>@<%=u.username%> · <%=u.phone||'—'%></small></span></a><div class="admin-user-badges"><span><%=u.role%></span><span class="<%=u.isSuspended?'bad':'ok'%>"><%=u.isSuspended?'Suspended':'Active'%></span></div><div class="admin-actions"><form method="post" action="/admin/users/<%=u._id%>/verify"><button class="btn ghost"><%=u.isVerified?'Unverify':'Verify'%></button></form><%if(u.role!=='admin'){%><form method="post" action="/admin/users/<%=u._id%>/role"><select name="role"><option value="user">User</option><option value="creator">Creator</option><option value="moderator">Moderator</option></select><button class="btn ghost">Role</button></form><form method="post" action="/admin/users/<%=u._id%>/suspend"><button class="btn <%=u.isSuspended?'ghost':'danger'%>"><%=u.isSuspended?'Faollashtir':'Suspend'%></button></form><%}%></div></article><%})%></div></section>
  <div class="admin-two-col"><section class="admin-panel card"><div class="admin-panel-head"><div><span class="settings-kicker">TOP CONTENT</span><h2>Top postlar</h2></div></div><div class="admin-top-posts"><%topPosts.forEach((p,i)=>{%><a href="/p/<%=p._id%>" class="admin-top-post"><b><%=i+1%></b><img src="<%=p.imageUrl%>"><span><strong>@<%=p.author?.username||'user'%></strong><small><i data-lucide="eye"></i> <%=p.viewCount||0%> · <i data-lucide="heart"></i> <%=p.likeCount||0%></small></span></a><%})%></div></section><section class="admin-panel card"><div class="admin-panel-head"><div><span class="settings-kicker">TOP CREATORS</span><h2>Creatorlar</h2></div></div><div class="admin-top-posts"><%topCreators.forEach((u,i)=>{%><a href="/u/<%=u.username%>" class="admin-top-post"><b><%=i+1%></b><span class="avatar"><%if(u.avatarUrl){%><img src="<%=u.avatarUrl%>"><%}else{%><b><%=u.name[0]%></b><%}%></span><span><strong><%=u.name%></strong><small>@<%=u.username%> · <%=u.followerCount||0%> follower</small></span></a><%})%></div></section></div>
  <div class="admin-two-col"><section class="admin-panel card" id="announcement"><div class="admin-panel-head"><div><span class="settings-kicker">ANNOUNCEMENT</span><h2>Platforma xabari</h2></div></div><form class="admin-announce" method="post" action="/admin/announce"><textarea name="text" maxlength="180" required placeholder="Yangi yangilanishlar tayyor ✨"></textarea><div><select name="target"><option value="all">Barcha foydalanuvchilar</option><option value="creators">Faqat creatorlar</option></select><button class="btn primary">Yuborish</button></div></form></section><section class="admin-panel card"><div class="admin-panel-head"><div><span class="settings-kicker">AUDIT LOG</span><h2>Admin amallari</h2></div></div><div class="admin-log-list"><%logs.forEach(l=>{%><div><span><i data-lucide="activity"></i></span><p><b><%=l.action%></b><small><%=l.admin?'@'+l.admin.username:'admin'%> · <%=l.details||l.targetId%></small></p><time><%=new Date(l.createdAt).toLocaleString('uz-UZ')%></time></div><%})%></div></section></div>
</main><%- include('../partials/footer') %>
