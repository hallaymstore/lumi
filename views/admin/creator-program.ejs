<%- include('../partials/head') %><%- include('../partials/topbar') %>
<main class="content creator-admin-page"><div class="program-section-title"><div><span class="settings-kicker">LUMI ADMIN</span><h1>Pro va monetizatsiya</h1></div><a class="btn ghost" href="/admin">Admin panel</a></div>
<%if(ok){%><div class="success-alert"><%=ok%></div><%}%>
<section class="card creator-panel"><h2>Arizalar</h2><%if(!applications.length){%><p class="muted">Arizalar hali yo‘q.</p><%}%>
<%applications.forEach(a=>{%><article class="program-admin-row"><div><b>@<%=a.user?.username||'user'%></b><span class="program-status <%=a.status%>"><%=a.status%></span><small><%=new Date(a.createdAt).toLocaleDateString('uz-UZ')%> · <%=a.snapshot?.realFollowers||0%> obunachi · <%=a.snapshot?.qualifiedViews30||0%> ko‘rish · <%=a.snapshot?.posts30||0%> post</small></div><%if(a.status==='pending'){%><form method="post" action="/admin/creator-program/application/<%=a._id%>"><input name="note" maxlength="600" placeholder="Izoh"><select name="status"><option value="approved">Qabul qilish</option><option value="rejected">Rad etish</option></select><button class="btn primary">Saqlash</button></form><%}else{%><small><%=a.note||'Qaror chiqarilgan'%></small><%}%></article><%})%>
</section>
<section class="card creator-panel"><h2>Pro hisoblar</h2><form method="get" class="program-user-search"><input name="q" value="<%=q%>" placeholder="Username"><button class="btn ghost">Qidirish</button></form><%users.forEach(u=>{%><div class="program-admin-row"><span><b>@<%=u.username%></b><small><%=u.name%> · <%=u.proExpiresAt&&new Date(u.proExpiresAt)>new Date()?'Pro: '+new Date(u.proExpiresAt).toLocaleDateString('uz-UZ'):'Oddiy hisob'%></small></span><%if(u.accountOrigin!=='synthetic'&&!u.managedByPlatform){%><form method="post" action="/admin/creator-program/pro/<%=u._id%>"><select name="days"><option value="30">30 kun Pro</option><option value="90">90 kun Pro</option><option value="0">Bekor qilish</option></select><button class="btn ghost">Qo‘llash</button></form><%}%></div><%})%></section>
<p class="muted tiny">Amallar audit logga yoziladi. Ariza tasdig‘i to‘lovni faollashtirmaydi.</p></main><%- include('../partials/footer') %>
