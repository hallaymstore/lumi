<%- include('../partials/head') %><%- include('../partials/topbar') %><main class="content narrow"><form class="card create-card" method="post" action="/posts/create" enctype="multipart/form-data">
  <div class="upload-preview multi-preview" data-preview><i data-lucide="images"></i><p>1–10 ta rasm yoki video tanlang</p><span>Rasm avtomatik WebP va thumbnailga optimallashtiriladi</span></div><%if(error){%><div class="alert"><%=error%></div><%}%>
  <label class="file-btn"><input type="file" name="images" accept="image/jpeg,image/png,image/webp,image/avif,video/mp4,video/webm" multiple required data-multi-image-input><i data-lucide="upload"></i> Media tanlash</label>
  <label class="mention-field">Caption<textarea name="caption" maxlength="2200" rows="4" placeholder="Bugungi kayfiyat... @username ✨" data-mention-input></textarea><div class="mention-suggestions" data-mention-suggestions hidden></div><small class="muted">@username mention va #tag ishlaydi.</small></label><label>Taglar<input name="tags" placeholder="#beauty #style #goodvibes"></label><button class="btn primary full">Postni joylash</button><p class="muted tiny">Maksimum 10 media. R2 uchun rasmlar avtomatik siqiladi va EXIF rotate qilinadi.</p>
</form></main><%- include('../partials/footer') %>
