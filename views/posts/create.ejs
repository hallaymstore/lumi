<%- include('../partials/head') %><%- include('../partials/topbar') %><main class="content narrow"><form class="card create-card" method="post" action="/posts/create" enctype="multipart/form-data">
  <div class="upload-preview multi-preview" data-preview><i data-lucide="images"></i><p>1–10 ta rasm yoki video tanlang</p><span>Rasm avtomatik WebP va thumbnailga optimallashtiriladi</span></div><%if(error){%><div class="alert"><%=error%></div><%}%>
  <label class="file-btn"><input type="file" name="images" accept="image/jpeg,image/png,image/webp,image/avif,video/mp4,video/webm" multiple data-multi-image-input><i data-lucide="upload"></i> Media tanlash</label>
  <label class="mention-field">Caption<textarea name="caption" maxlength="2200" rows="4" placeholder="Bugungi kayfiyat... @username ✨" data-mention-input></textarea><div class="mention-suggestions" data-mention-suggestions hidden></div><small class="muted">@username mention va #tag ishlaydi.</small></label><label>Taglar<input name="tags" placeholder="#beauty #style #goodvibes"></label>
  <div class="profile-library"><button class="btn primary" type="submit" formaction="/posts/create">Postni joylash</button><button class="btn ghost" type="submit" formaction="/posts/create-draft" formnovalidate><i data-lucide="file-clock"></i> Qoralama saqlash</button></div><p class="muted tiny">Joylash uchun kamida 1 media kerak. Qoralamani caption bilan mediasiz ham saqlash mumkin. Maksimum 10 media.</p>
</form></main><%- include('../partials/footer') %>
