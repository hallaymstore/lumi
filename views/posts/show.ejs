<%- include('../partials/head') %><%- include('../partials/topbar') %><main class="content post-detail-page"><div class="post-detail-head"><a href="/feed" class="back-link"><i data-lucide="arrow-left"></i> Feed</a><div><span>POST</span><strong>Doimiy havola</strong></div><button class="btn ghost compact" type="button" data-share-open="<%=post._id%>"><i data-lucide="share-2"></i> Ulashish</button></div><section class="post-detail-grid"><div><%- include('../partials/postcard',{p:post}) %><%if(adConfig?.enabled&&postAds?.length){const ad=postAds[0];%><%- include('../partials/adcard',{ad,placement:'post_detail',variant:'native',adConfig}) %><%}%></div><aside class="post-detail-side card"><span class="detail-author-kicker">CREATOR</span><a class="detail-author" href="/u/<%=post.author.username%>"><span class="avatar"><%if(post.author.avatarUrl){%><img src="<%=post.author.avatarUrl%>"><%}else{%><b><%=post.author.name[0]%></b><%}%></span><span><strong><%=post.author.name%></strong><small>@<%=post.author.username%></small></span></a><p><%=post.author.bio||'Lumi creator'%></p><div class="detail-stat-row"><span><b><%=post.viewCount||0%></b><small>ko‘rish</small></span><span><b><%=post.likeCount||0%></b><small>like</small></span><span><b><%=post.commentCount||0%></b><small>comment</small></span></div><button class="btn primary full" type="button" data-share-open="<%=post._id%>"><i data-lucide="send"></i> Postni ulashish</button></aside></section></main><%- include('../partials/postsheets',{shareTargets}) %><%- include('../partials/footer') %>
