<%- include('partials/head') %><%- include('partials/topbar') %>
<main class="content explore-page"><div class="explore-heading"><div><span class="settings-kicker">DISCOVER</span><h1>Kashf etish</h1><p class="muted">Creator, username, caption va #tag bo‘yicha qidiring.</p></div><% if(!currentUser){%><a class="btn primary" href="/register">Qo‘shilish</a><%}%></div>
<form class="search search-v15" method="get" action="/explore"><i data-lucide="search"></i><input name="q" value="<%= q %>" placeholder="@username, creator yoki #tag"><button>Qidirish</button></form>
<h2 class="section-title">Creatorlar</h2><div class="creator-row"><% users.forEach(u=>{ %><a class="creator-pill" href="/u/<%= u.username %>"><span><img src="<%=u.avatarUrl||'/icons/icon-192.png'%>" class="<%=u.avatarUrl?'':'avatar-fallback'%>" alt=""></span><strong><%=u.name%></strong><small>@<%=u.username%></small></a><%})%></div>
<%if(adConfig?.enabled&&(exploreAds?.length||adConfig.networkEnabled)){%><div class="explore-ad-slot"><%if(exploreAds?.length){const ad=exploreAds[0];%><%- include('partials/adcard',{ad,placement:'explore',variant:'banner',adConfig}) %><%}else{%><%- include('partials/networkad',{placement:'explore',variant:'banner',adConfig}) %><%}%></div><%}%>
<h2 class="section-title"><%= q ? 'Topilgan postlar' : 'Trend postlar' %></h2><div class="explore-grid explore-grid-v15"><% posts.forEach(p=>{ %><a href="/p/<%=p._id%>" data-view-track data-post-id="<%=p._id%>"><img src="<%=p.imageUrl%>" loading="lazy" alt="<%=(p.caption||'Lumi post').slice(0,80)%>"><span><i data-lucide="heart"></i> <%=p.likes.length%> · <i data-lucide="eye"></i> <b data-view-count><%=p.viewCount||0%></b></span></a><%})%></div></main><%- include('partials/footer') %>
