 <%clips.forEach((p,clipIndex)=>{const m=p.video,own=currentUser&&String(currentUser._id)===String(p.author._id),poster=m.posterUrl||m.thumbUrl||'',isPro=p.author.proExpiresAt&&new Date(p.author.proExpiresAt)>new Date();%>
 <article class="lumi-clip" data-clip data-post-id="<%=p._id%>" data-post-author="<%=p.author._id%>" aria-label="@<%=p.author.username%> video posti">
  <div class="lumi-clip-stage" data-clip-stage>
   <%if(poster){%><div class="lumi-clip-backdrop" aria-hidden="true" style="background-image:url('<%=String(poster).replace(/['"\\()\s]/g,encodeURIComponent)%>')"></div><%}%>
   <video class="lumi-clip-video" muted playsinline webkit-playsinline loop preload="none" <%=poster?'poster="'+String(poster).replace(/"/g,'&quot;')+'"':''%> data-source="<%=m.playbackUrl||m.url%>" aria-label="@<%=p.author.username%> videosi">
    <%if(m.captionsUrl){%><track kind="captions" label="Subtitr" srclang="<%=m.captionsLang||'uz'%>" src="/api/clips/caption/<%=p._id%>?i=<%=(p.media||[]).findIndex(x=>x.type==='video')%>"><%}%>
   </video>
   <button class="lumi-clip-hit" type="button" data-clip-toggle aria-label="Videoni boshlash yoki pauza qilish"></button>
   <div class="lumi-clip-flash" data-clip-flash aria-hidden="true"><i class="ic-play" data-lucide="play"></i><i class="ic-pause" data-lucide="pause"></i></div>
   <div class="lumi-clip-heart" data-clip-heart aria-hidden="true"><i data-lucide="heart"></i></div>
   <div class="lumi-clip-buffer" data-clip-buffer hidden><i data-lucide="loader-circle"></i></div>
   <button class="lumi-clip-sound" type="button" data-clip-mute aria-label="Ovozni yoqish yoki o‘chirish"><i class="ic-off" data-lucide="volume-x"></i><i class="ic-on" data-lucide="volume-2"></i><span data-clip-sound-label>Tovushni yoqish</span></button>

   <div class="lumi-clip-info">
    <a class="lumi-clip-author" href="/u/<%=p.author.username%>"><img src="<%=p.author.avatarUrl||'/icons/icon-192.png'%>" alt="" width="40" height="40"><span><b><%=p.author.name%></b><small>@<%=p.author.username%><%if(isPro){%> · ✦ Pro<%}%></small></span></a>
    <p class="lumi-clip-description" data-clip-description><%-p.captionHtml||p.caption||''%></p>
    <%if(p.tags&&p.tags.length){%><p class="lumi-clip-tags"><%=p.tags.slice(0,4).map(t=>'#'+t).join(' ')%></p><%}%>
   </div>

   <div class="lumi-clip-actions">
    <%if(currentUser){%><form class="inline ajax-like-form" method="post" action="/posts/<%=p._id%>/like"><button class="lumi-clip-action <%=p.likedByMe?'liked':''%>" aria-label="Yoqdi"><i data-lucide="heart"></i><small data-like-count><%=p.likeCount||0%></small></button></form><%}else{%><button class="lumi-clip-action" type="button" data-auth-required aria-label="Yoqdi"><i data-lucide="heart"></i><small data-like-count><%=p.likeCount||0%></small></button><%}%>
    <button class="lumi-clip-action" type="button" data-comments-open="<%=p._id%>" aria-label="Izohlarni ochish"><i data-lucide="message-circle"></i><small data-clip-comments-count><%=p.commentCount||0%></small></button>
    <button class="lumi-clip-action" type="button" data-share-open="<%=p._id%>" aria-label="Ulashish"><i data-lucide="send"></i><small>Ulashish</small></button>
    <button class="lumi-clip-action" type="button" data-clip-settings aria-label="Qo‘shimcha sozlamalar" aria-expanded="false"><i data-lucide="ellipsis"></i></button>
   </div>

   <div class="lumi-clip-menu" data-clip-menu hidden role="menu" aria-label="Video sozlamalari">
    <button type="button" role="menuitem" data-clip-speed><i data-lucide="gauge"></i> Tezlik <b data-speed-value>1×</b></button>
    <button type="button" role="menuitem" data-clip-cc <%=m.captionsUrl?'':'disabled'%>><i data-lucide="captions"></i> Subtitr</button>
    <button type="button" role="menuitem" data-clip-pip><i data-lucide="picture-in-picture-2"></i> Mini pleyer</button>
    <button type="button" role="menuitem" data-clip-fullscreen><i data-lucide="maximize"></i> To‘liq ekran</button>
    <a role="menuitem" href="/p/<%=p._id%>"><i data-lucide="external-link"></i> Post sahifasi</a>
   </div>

   <div class="lumi-clip-progress" data-clip-progress>
    <span class="lumi-clip-time" data-clip-time>0:00 / 0:00</span>
    <input type="range" min="0" max="1000" step="1" value="0" data-clip-seek aria-label="Video vaqti">
   </div>
  </div>
 </article>
 <%})%>
