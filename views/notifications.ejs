<%- include('partials/head') %><%- include('partials/topbar') %><main class="content narrow"><div class="page-title-row"><div><h1>Faollik</h1><p class="muted">Guruhlangan like/follow, comment, mention, chat va moderatsiya xabarlari.</p></div></div>
<%if(requests&&requests.length){%><section class="card follow-requests"><h2>Obuna so‘rovlari</h2><%requests.forEach(r=>{const u=r.follower;if(!u)return;%><article><a class="user-line" href="/u/<%=u.username%>"><span class="avatar"><%if(u.avatarUrl){%><img src="<%=u.avatarUrl%>"><%}else{%><b><%=u.name[0]%></b><%}%></span><span><strong><%=u.name%></strong><small>@<%=u.username%></small></span></a><div><form method="post" action="/follow-requests/<%=r._id%>/accept"><button class="btn primary">Qabul</button></form><form method="post" action="/follow-requests/<%=r._id%>/reject"><button class="btn ghost">Rad etish</button></form></div></article><%})%></section><%}%>
<div class="notification-list"><%if(!items.length&&!requests?.length){%><div class="card empty"><i data-lucide="bell-ring"></i><p>Hozircha bildirishnoma yo‘q.</p></div><%}%><%items.forEach(n=>{const href=n.conversation?'/chats/'+n.conversation:(n.post?'/p/'+n.post._id:(n.actor?.username?'/u/'+n.actor.username:'/notifications'));const count=n.actorCount||1;%><a class="notification card" href="<%=href%>"><span class="avatar"><%if(n.actor?.avatarUrl){%><img src="<%=n.actor.avatarUrl%>"><%}else{%><i data-lucide="sparkles"></i><%}%></span><div><strong><%=n.actor?.username?'@'+n.actor.username:'Lumi'%><%=count>1?' va yana '+(count-1)+' kishi':''%></strong><p><%=n.text%></p><small><%=new Date(n.lastActivityAt||n.createdAt).toLocaleString('uz-UZ')%></small></div><%if(n.post?.imageUrl){%><img class="notif-thumb" src="<%=n.post.imageUrl%>"><%}else if(n.story?.mediaUrl){%><img class="notif-thumb" src="<%=n.story.mediaUrl%>"><%}%></a><%})%></div></main><%- include('partials/footer') %>
