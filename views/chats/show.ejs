<%- include('../partials/head') %><%- include('../partials/topbar') %>
<main class="chat-detail-page"><section class="chat-room" data-chat-room data-conversation-id="<%=conversation._id%>" data-other-user-id="<%=other._id%>">
<div class="chat-room-head glass"><a class="icon-btn" href="/chats"><i data-lucide="arrow-left"></i></a><a href="/u/<%=other.username%>" class="user-line chat-peer"><span class="avatar"><%if(other.avatarUrl){%><img src="<%=other.avatarUrl%>"><%}else{%><b><%=other.name[0]%></b><%}%></span><span><strong><%=other.name%> <%if(other.isVerified){%><i class="verified" data-lucide="badge-check"></i><%}%></strong><small data-peer-status><%=other.online?'online':'@'+other.username%></small></span></a><a class="icon-btn" href="/u/<%=other.username%>"><i data-lucide="info"></i></a></div>
<%if(conversation.pinnedMessage){%><div class="pinned-message-bar"><i data-lucide="pin"></i><span><b>Pin qilingan xabar</b><small><%=(conversation.pinnedMessage.text||'Media').slice(0,90)%></small></span></div><%}%>
<div class="message-scroll" data-message-scroll><div class="older-messages-wrap"><button class="btn ghost compact" type="button" data-load-older <%=hasOlder?'':'hidden'%>><i data-lucide="history"></i> Oldingi xabarlar</button></div>
<%messages.forEach((m,i)=>{const mine=m.sender&&String(m.sender._id)===String(currentUser._id);const reactionCounts={};(m.reactions||[]).forEach(r=>reactionCounts[r.emoji]=(reactionCounts[r.emoji]||0)+1);const consumed=!!m.ephemeralConsumedAt||(m.ephemeralExpiresAt&&new Date(m.ephemeralExpiresAt)<=new Date());%><div class="message-wrap <%=mine?'mine':'theirs'%>" data-message-wrap data-message-id="<%=m._id%>" data-created-at="<%=new Date(m.createdAt).toISOString()%>" id="<%=i===messages.length-1?'latest':''%>"><div class="message-bubble <%=m.ephemeral?'ephemeral-message':''%>">
<%if(m.replyTo){%><div class="reply-quote"><i data-lucide="corner-up-left"></i><span><%=(m.replyTo.text||'Media').slice(0,100)%></span></div><%}%>
<%if(m.post){%><a class="shared-post" href="/p/<%=m.post._id%>"><img src="<%=m.post.media?.[0]?.thumbUrl||m.post.imageUrl%>"><div><span class="shared-label"><i data-lucide="send"></i> Post</span><strong>@<%=m.post.author?.username||'user'%></strong><p><%=m.post.caption%></p></div></a><%}%>
<%if(m.storyPreviewUrl){%><div class="shared-story"><img src="<%=m.storyPreviewUrl%>"><div><span class="shared-label"><i data-lucide="circle-play"></i> Storyga javob</span><strong>@<%=m.storyAuthorUsername||other.username%></strong><p><%=m.storyPreviewCaption||'Story'%></p></div></div><%}%>
<%if(m.ephemeral&&m.mediaType==='image'){%><%if(mine){%><div class="once-photo once-photo-sent"><span class="once-photo-icon"><i data-lucide="camera"></i></span><div><strong>Bir martalik surat</strong><small><%=consumed?'Ko‘rildi · surat o‘chirildi':(m.ephemeralOpenedAt?'Ochildi · 10 soniya':'Yetkazildi')%></small></div></div><%}else if(consumed){%><div class="once-photo once-photo-expired"><span class="once-photo-icon"><i data-lucide="eye-off"></i></span><div><strong>Surat ko‘rildi</strong><small>Bir martalik media o‘chirildi</small></div></div><%}else{%><button class="once-photo once-photo-open" type="button" data-ephemeral-open data-conversation="<%=conversation._id%>" data-message="<%=m._id%>"><span class="once-photo-icon"><i data-lucide="camera"></i></span><div><strong>Bir martalik surat</strong><small>Ochilgach 10 soniya</small></div><i data-lucide="chevron-right"></i></button><%}%><%}%>
<%if(!m.ephemeral&&m.mediaUrl){%><%if(m.mediaType==='image'){%><img class="chat-media-image" src="<%=m.mediaUrl%>"><%}else if(m.mediaType==='video'){%><video class="chat-media-video" src="<%=m.mediaUrl%>" controls playsinline></video><%}else if(m.mediaType==='audio'){%><audio class="chat-media-audio" src="<%=m.mediaUrl%>" controls></audio><%}else{%><a class="chat-file" href="<%=m.mediaUrl%>" target="_blank"><i data-lucide="paperclip"></i> <%=m.mediaName||'Fayl'%></a><%}%><%}%>
<%if(m.deletedForEveryoneAt){%><p class="message-deleted"><i data-lucide="ban"></i> Xabar o‘chirildi</p><%}else if(m.text){%><p class="message-text"><%=m.text%></p><%}%><small class="message-time"><%=new Date(m.createdAt).toLocaleTimeString('uz-UZ',{hour:'2-digit',minute:'2-digit'})%> <%=m.editedAt?'· tahrirlangan':''%></small><div class="message-reactions" data-message-reactions><%Object.entries(reactionCounts).forEach(([emoji,count])=>{%><span><%=emoji%> <%=count%></span><%})%></div><div class="reaction-picker"><%['❤️','😂','🔥','😮','👍'].forEach(e=>{%><button type="button" data-message-react="<%=e%>" data-conversation="<%=conversation._id%>" data-message="<%=m._id%>"><%=e%></button><%})%><button type="button" data-message-reply="<%=m._id%>" data-message-preview="<%=(m.text||'Media').slice(0,80)%>"><i data-lucide="reply"></i></button><button type="button" data-message-pin="<%=m._id%>"><i data-lucide="pin"></i></button><%if(!mine){%><button type="button" data-message-report="<%=m._id%>"><i data-lucide="flag"></i></button><%}%><%if(mine&&!m.deletedForEveryoneAt){%><button type="button" data-message-edit="<%=m._id%>" data-message-text="<%=m.text%>"><i data-lucide="pencil"></i></button><button type="button" data-message-delete="<%=m._id%>"><i data-lucide="trash-2"></i></button><%}%></div></div></div><%})%><div class="typing-row" data-typing-indicator hidden><span></span><span></span><span></span></div></div>
<div class="chat-reply-banner" data-chat-reply-banner hidden><span><i data-lucide="reply"></i><b data-chat-reply-label></b></span><button type="button" data-chat-reply-cancel><i data-lucide="x"></i></button></div>
<form class="chat-composer glass" method="post" action="/chats/<%=conversation._id%>/messages" data-chat-composer><input type="hidden" name="replyTo" data-chat-reply-id><button type="button" class="composer-camera" data-camera-open><i data-lucide="camera"></i></button><label class="composer-attach"><i data-lucide="paperclip"></i><input type="file" data-chat-media accept="image/*,video/mp4,video/webm,audio/*,application/pdf,.zip,.txt"></label><button type="button" class="composer-voice" data-voice-record><i data-lucide="mic"></i></button><input name="text" maxlength="2400" autocomplete="off" placeholder="Xabar yozing…" data-chat-input><button class="send-circle" type="submit"><i data-lucide="send"></i></button></form></section></main>
<div class="camera-overlay" data-camera-overlay hidden data-conversation="<%=conversation._id%>"><section class="camera-shell"><div class="camera-top"><button type="button" class="camera-icon-btn" data-camera-close><i data-lucide="x"></i></button><div><strong>Bir martalik surat</strong><small>Ochilgach 10 soniya</small></div><button type="button" class="camera-icon-btn" data-camera-switch><i data-lucide="refresh-cw"></i></button></div><div class="camera-stage"><video data-camera-video autoplay muted playsinline></video><canvas data-camera-canvas hidden></canvas><img data-camera-preview hidden><div class="camera-permission" data-camera-permission><i data-lucide="camera"></i><p>Kameraga ruxsat bering</p></div></div><div class="camera-bottom"><label class="camera-gallery-fallback"><i data-lucide="image-plus"></i><input type="file" accept="image/*" capture="environment" data-camera-file></label><button type="button" class="camera-capture" data-camera-capture><span></span></button><button type="button" class="camera-send" data-camera-send hidden><i data-lucide="send"></i><span>Yuborish</span></button><button type="button" class="camera-retake" data-camera-retake hidden><i data-lucide="rotate-ccw"></i><span>Qayta</span></button></div></section></div><div class="ephemeral-viewer" data-ephemeral-viewer hidden><div class="ephemeral-viewer-bg"></div><div class="ephemeral-viewer-top"><span><i data-lucide="timer"></i> Bir martalik surat</span><strong data-ephemeral-count>10</strong></div><div class="ephemeral-progress"><i data-ephemeral-progress></i></div><img data-ephemeral-image><p>10 soniyadan so‘ng o‘chadi</p></div><%- include('../partials/footer') %>
