<%- include('../partials/head') %><%- include('../partials/topbar') %>
<main class="content chat-list-page"><section class="chat-column"><div class="chat-page-title"><div><h1>Xabarlar</h1><p class="muted">Do‘stlaringiz bilan post, story va fikrlarni ulashing.</p></div><a class="icon-btn chat-search" href="/explore"><i data-lucide="user-plus"></i></a></div>
<%- include('../partials/notesrail', { notePeople }) %>
<div class="chat-list card" data-chat-list><% if(!items.length){ %><div class="empty"><i data-lucide="messages-square"></i><h2>Hali suhbat yo‘q</h2><p>Biror profilga obuna bo‘ling va “Xabar yozish”ni bosing.</p><a href="/explore" class="btn primary">Odamlarni topish</a></div><% } %>
<% items.forEach(c=>{ %><a class="chat-row" data-conversation-row="<%=c._id%>" href="/chats/<%=c._id%>"><span class="avatar chat-avatar"><%if(c.other.avatarUrl){%><img src="<%=c.other.avatarUrl%>"><%}else{%><b><%=c.other.name[0]%></b><%}%><% if(c.other.online){%><i class="online-dot"></i><%}%></span><span class="chat-row-main"><strong><%=c.other.name%> <%if(c.other.isVerified){%><i class="verified" data-lucide="badge-check"></i><%}%></strong><small data-chat-preview><%=c.lastMessageText || '@'+c.other.username%></small></span><span class="chat-row-meta"><small data-chat-time><%= new Date(c.lastMessageAt).toLocaleDateString('uz-UZ',{day:'2-digit',month:'2-digit'}) %></small><b data-chat-unread <%=c.unread?'':'hidden'%>><%=c.unread>99?'99+':c.unread%></b></span></a><% }) %></div><%if(adConfig?.enabled&&adConfig.chatsEnabled&&(chatAds?.length||adConfig.networkEnabled)){%><div class="chat-list-ad"><%if(chatAds?.length){const ad=chatAds[0];%><%- include('../partials/adcard',{ad,placement:'chat_list',variant:'compact',adConfig}) %><%}else{%><%- include('../partials/networkad',{placement:'chat_list',variant:'banner',adConfig}) %><%}%></div><%}%></section></main>
<%- include('../partials/footer') %>
