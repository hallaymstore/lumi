<%- include('../partials/head') %><%- include('../partials/topbar') %>
<main class="content analytics-page"><div class="analytics-hero"><div><span class="settings-kicker">LUMI CREATOR</span><h1>Creator Analytics</h1><p class="muted">Auditoriya signallari, reach va eng kuchli postlaringiz.</p></div><a class="btn ghost" href="/u/<%=currentUser.username%>"><i data-lucide="user-round"></i> Profil</a></div>
<section class="analytics-stats"><%[['eye','Ko‘rishlar',totals.views],['heart','Like',totals.likes],['message-circle','Izoh',totals.comments],['bookmark','Save',totals.saves],['send','Share',totals.shares]].forEach(x=>{%><article class="card analytics-stat"><i data-lucide="<%=x[0]%>"></i><span><small><%=x[1]%></small><b><%=Number(x[2]||0).toLocaleString('uz-UZ')%></b></span></article><%})%></section>
<section class="analytics-grid"><article class="card analytics-panel"><div class="analytics-panel-head"><div><span class="settings-kicker">30 KUN</span><h2>Feed signallari</h2></div><i data-lucide="activity"></i></div><div class="signal-list"><%if(!events30.length){%><p class="muted">Hali yetarli signal yo‘q.</p><%}%><%events30.sort((a,b)=>b.count-a.count).forEach(e=>{%><div><span><b><%=e._id%></b><small>Algoritm signali</small></span><strong><%=Number(e.count||0).toLocaleString('uz-UZ')%></strong></div><%})%></div></article>
<article class="card analytics-panel"><div class="analytics-panel-head"><div><span class="settings-kicker">7 KUN</span><h2>So‘nggi faollik</h2></div><i data-lucide="trending-up"></i></div><div class="signal-list"><%if(!events7.length){%><p class="muted">Hali yetarli signal yo‘q.</p><%}%><%events7.sort((a,b)=>b.count-a.count).forEach(e=>{%><div><span><b><%=e._id%></b><small>So‘nggi 7 kun</small></span><strong><%=Number(e.count||0).toLocaleString('uz-UZ')%></strong></div><%})%></div></article></section>
<section class="card analytics-panel top-content"><div class="analytics-panel-head"><div><span class="settings-kicker">TOP CONTENT</span><h2>Eng kuchli postlar</h2></div><i data-lucide="sparkles"></i></div><div class="analytics-post-grid"><%if(!top.length){%><div class="empty-mini">Hali post yo‘q.</div><%}%><%top.forEach(p=>{const img=(p.media&&p.media[0]&&(p.media[0].thumbUrl||p.media[0].url))||p.imageUrl;%><a href="/p/<%=p._id%>" class="analytics-post"><%if(img){%><img src="<%=img%>" alt=""><%}%><span><b><%=Number(p.viewCount||0).toLocaleString('uz-UZ')%> ko‘rish</b><small>❤️ <%=Math.max(Number(p.likeCount||0),p.likes?.length||0)%> · 💬 <%=Math.max(Number(p.commentCount||0),p.comments?.length||0)%> · 🔖 <%=p.saveCount||0%></small></span></a><%})%></div></section>
</main><%- include('../partials/footer') %>
